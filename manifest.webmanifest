function getLocalizacoesPorPavimento_() {

  return {

    "ÁREA EXTERNA":[
      "Guarita",
      "Subestação",
      "Abrigo de Resíduos",
      "Estacionamento",
      "Área Externa",
      "Sala do Gerador 1",
      "Sala do Gerador 2"
    ],

    "1º PISO":[
      "Recepção",
      "Expedição",
      "Laboratório de Produção",
      "Sala de Lavagem",
      "Sala do Liofilizador",
      "Hall do Café",
      "Corredor das Câmaras Frigoríficas"
    ],

    "2º PISO":[
