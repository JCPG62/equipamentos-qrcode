      mapa[normId_(id)] ||
      []
    ).length
  );

  Logger.log(
    JSON.stringify(
      mapa[normId_(id)] || [],
      null,
      2
    )
  );

  Logger.log(
    "================================"
  );
}


/* ============================================================
 * CONTROLE MENSAL
 * ============================================================ */

function getMonthlyPreventiveControl_(
  competenciaInformada,
  sessao,
  filtroPrestador
) {

  var competencia =
    resolverCompetencia_(
      competenciaInformada
    );

  var filtro =
    String(
      filtroPrestador || ""
    ).trim();

  /*
   * Prestador comum nunca pode consultar outro.
   */

  if (
    !isWideScopeSession_(sessao)
  ) {

    filtro =
      sessao.prestador;
  }

  var ativos =
    readEquipmentSheet_();

  var mapa =
    getPreventiveMapByCompetencia_(
      competencia
    );

  var realizadas = [];
  var pendentes = [];

  ativos.forEach(
    function(ativo) {

      if (
        !isPeriodicidadeMensal_(
          ativo.periodicidade
        )
      ) {

        return;
      }

      if (
        !prestadorPermitido_(
          sessao,
          ativo.prestador
        )
      ) {

        return;
      }

      if (
        filtro &&
        normalizarBusca_(
          ativo.prestador
        ) !==
        normalizarBusca_(
          filtro
        )
      ) {

        return;
      }

      var id =
        normId_(
          ativo.id
        );

      var registros =
        mapa[id] || [];

      var validos =
        registros.filter(
          function(r) {

            return (
              normalizarBusca_(
                r.status
              ) === "realizada"
            );
          }
        );

      validos.sort(
        function(a,b) {

          return (
            new Date(b.data) -
            new Date(a.data)
          );
        }
      );

      var item = {

        id:
          ativo.id || "",

        nome:
          ativo.nome_do_equipamento || "",

        periodicidade:
          ativo.periodicidade || "",

        prestador:
          ativo.prestador || "",

        pavimento:
          ativo.pavimento || "",

        localizacao:
          ativo.localizacao || "",

        localDetalhado:
          ativo.local_detalhado || "",

        ambiente:
          ativo.ambiente || "",

        observacaoEquipamento:
          ativo.observacoes || "",

        preventivaRealizada:
          validos.length > 0,

        ultimoRegistro:
          validos.length
            ? validos[0]
            : null

      };

      if (
        item.preventivaRealizada
      ) {

        realizadas.push(
          item
        );

      } else {

        pendentes.push(
          item
        );
      }
    }
  );

  realizadas.sort(
    function(a,b) {

      return String(a.nome)
        .localeCompare(
          String(b.nome),
          "pt-BR"
        );
    }
  );

  pendentes.sort(
    function(a,b) {

      return String(a.nome)
        .localeCompare(
          String(b.nome),
          "pt-BR"
        );
    }
  );

  var previstas =
    realizadas.length +
    pendentes.length;

  var percentual =
    previstas
      ? Number(
          (
            realizadas.length /
            previstas *
            100
          ).toFixed(1)
        )
      : 0;

  var prestadoresMap = {};

  realizadas
    .concat(
      pendentes
    )
    .forEach(
      function(item) {

        var nome =
          item.prestador ||
          "Não informado";

        if (
          !prestadoresMap[nome]
        ) {

          prestadoresMap[nome] = {

            prestador:nome,
            previstas:0,
            realizadas:0,
            pendentes:0,
            percentual:0

          };
        }

        prestadoresMap[nome]
          .previstas++;

        if (
          item.preventivaRealizada
        ) {

          prestadoresMap[nome]
            .realizadas++;

        } else {

          prestadoresMap[nome]
            .pendentes++;
        }
      }
    );

  var prestadores =
    Object.keys(
      prestadoresMap
    )
    .map(
      function(k) {

        var x =
          prestadoresMap[k];

        x.percentual =
          x.previstas
            ? Number(
                (
                  x.realizadas /
                  x.previstas *
                  100
                )
                .toFixed(1)
              )
            : 0;

        return x;
      }
    );

  return {

    competencia:
      competencia,

    competenciaDescricao:
      formatarCompetenciaPtBr_(
        competencia
      ),

    filtroPrestador:
      filtro,

    perfil:
      sessao.perfil,

    prestadorSessao:
      sessao.prestador,

    summary:{

      previstas:
        previstas,

      realizadas:
        realizadas.length,

      pendentes:
        pendentes.length,

      percentual:
        percentual

    },

    prestadores:
      prestadores,

    pendentes:
      pendentes.slice(
        0,
        CONFIG.PREVENTIVE_CONTROL_LIMIT
      ),

    realizadas:
      realizadas.slice(
        0,
        CONFIG.PREVENTIVE_CONTROL_LIMIT
      )

  };
}


/* ============================================================
 * RELATÓRIOS ENVIADOS
 * ============================================================ */

function preparePreventiveReportLogSheet_() {

  var ss =
    getSpreadsheet_();

  var sh =
    ss.getSheetByName(
      CONFIG.PREVENTIVE_REPORT_LOG_SHEET
    );

  if (!sh) {

    sh =
      ss.insertSheet(
        CONFIG.PREVENTIVE_REPORT_LOG_SHEET
      );
  }

  var headers = [

    "Data/Hora",
    "Competência",
    "Escopo / Prestador",
    "Previstas",
    "Realizadas",
    "Pendentes",
    "Percentual",
    "Enviado por",
    "Perfil",
    "E-mail"

  ];

  sh.getRange(
    1,
    1,
    1,
    headers.length
  )
  .setValues([
    headers
  ])
  .setFontWeight(
    "bold"
  );

  sh.setFrozenRows(1);

  return sh;
}


/* ============================================================
 * CONFIGURAÇÃO DO ENVIO DO RELATÓRIO
 * ============================================================ */

function resolverConfigRelatorio_(sessao,filtroPrestador) {

  /*
   * PRESTADOR:
   * usa a configuração dele.
   */

  if (
    !isWideScopeSession_(sessao)
  ) {

    var configPrestador =
      getProviderReportConfig_(
        sessao.prestador
      );

    return {

      permitido:
        configPrestador.permitido,

      emails:
        configPrestador.emails,

      emailString:
        configPrestador.emailString,

      escopo:
        sessao.prestador

    };
  }


  /*
   * MASTER + prestador selecionado:
   * usa configuração do prestador.
   */

  if (
    filtroPrestador
  ) {

    var configSelecionado =
      getProviderReportConfig_(
        filtroPrestador
      );

    return {

      permitido:
        configSelecionado.permitido,

      emails:
        configSelecionado.emails,

      emailString:
        configSelecionado.emailString,

      escopo:
        filtroPrestador

    };
  }


  /*
   * MASTER + TODOS:
   * usa configuração da linha do PNCQ/MASTER.
   */

  var configMaster =
    getProviderReportConfig_(
      sessao.prestador
    );

  return {

    permitido:
      configMaster.permitido,

    emails:
      configMaster.emails,

    emailString:
      configMaster.emailString,

    escopo:
      "Todos os prestadores"

  };
}


/* ============================================================
 * HTML DO RELATÓRIO
 * ============================================================ */

function montarHtmlRelatorioPreventivas_(data,escopo) {

  var s =
    data.summary;

  var html = `

    <div style="
      font-family:Arial,sans-serif;
      color:#222;
      max-width:900px;
      margin:auto;
    ">

      <h2 style="color:#1f4e78">
        QRManut – Relatório de Manutenções Preventivas
      </h2>

      <p>
        <strong>Competência:</strong>
        ${escapeHtml_(data.competenciaDescricao)}
      </p>

      <p>
        <strong>Escopo:</strong>
        ${escapeHtml_(escopo)}
      </p>

      <table
        cellpadding="10"
        cellspacing="0"
        style="
          border-collapse:collapse;
          width:100%;
          margin:20px 0;
        "
      >

        <tr>

          <td style="
            border:1px solid #ddd;
            text-align:center;
          ">
            <strong>${s.previstas}</strong>
            <br>
            Previstas
          </td>

          <td style="
            border:1px solid #ddd;
            text-align:center;
          ">
            <strong>${s.realizadas}</strong>
            <br>
            Realizadas
          </td>

          <td style="
            border:1px solid #ddd;
            text-align:center;
          ">
            <strong>${s.pendentes}</strong>
            <br>
            Pendentes
          </td>

          <td style="
            border:1px solid #ddd;
            text-align:center;
          ">
            <strong>${s.percentual}%</strong>
            <br>
            Conclusão
          </td>

        </tr>

      </table>

      <h3 style="color:#047857">
        ✅ Preventivas realizadas
      </h3>

  `;


  if (
    !data.realizadas.length
  ) {

    html +=
      "<p>Nenhuma preventiva realizada nesta competência.</p>";

  } else {

    data.realizadas.forEach(
      function(item) {

        var registro =
          item.ultimoRegistro ||
          {};

        html += `

          <div style="
            border:1px solid #ccc;
            border-left:5px solid #047857;
            padding:14px;
            margin:10px 0;
            border-radius:6px;
          ">

            <strong>
              ${escapeHtml_(item.id)}
              –
              ${escapeHtml_(item.nome)}
            </strong>

            <br><br>

            <strong>Prestador:</strong>
            ${escapeHtml_(item.prestador || "-")}
            <br>

            <strong>Pavimento:</strong>
            ${escapeHtml_(item.pavimento || "-")}
            <br>

            <strong>Localização:</strong>
            ${escapeHtml_(item.localizacao || "-")}
            <br>

            ${
              item.localDetalhado
                ? `
                  <strong>Local detalhado:</strong>
                  ${escapeHtml_(item.localDetalhado)}
                  <br>
                `
                : ""
            }

            <strong>Data da preventiva:</strong>
            ${escapeHtml_(
              registro.data
                ? Utilities.formatDate(
                    new Date(registro.data),
                    Session.getScriptTimeZone(),
                    "dd/MM/yyyy HH:mm"
                  )
                : "-"
            )}
            <br>

            <strong>Responsável:</strong>
            ${escapeHtml_(registro.responsavel || "-")}
            <br>

            ${
              item.observacaoEquipamento
                ? `

                  <br>

                  <strong>
                    Observação do equipamento:
                  </strong>

                  <br>

                  ${escapeHtml_(item.observacaoEquipamento)}

                `
                : ""
            }

            ${
              registro.observacao
                ? `

                  <br><br>

                  <strong>
                    Observação da preventiva:
                  </strong>

                  <br>

                  ${escapeHtml_(registro.observacao)}

                `
                : ""
            }

            ${
              registro.foto
                ? `

                  <br><br>

                  <a href="${escapeHtml_(registro.foto)}">
                    📷 Ver foto/evidência
                  </a>

                `
                : ""
            }

            ${
              registro.assinatura
                ? `

                  <br>

                  <a href="${escapeHtml_(registro.assinatura)}">
                    ✍️ Ver assinatura
                  </a>

                `
                : ""
            }

          </div>

        `;
      }
    );
  }


  html += `

      <h3 style="
        color:#b91c1c;
        margin-top:30px;
      ">
        🔴 Preventivas pendentes
      </h3>

  `;


  if (
    !data.pendentes.length
  ) {

    html += `

      <p>
        ✅ Nenhuma preventiva pendente nesta competência.
      </p>

    `;

  } else {

    data.pendentes.forEach(
      function(item) {

        html += `

          <div style="
            border:1px solid #ccc;
            border-left:5px solid #b91c1c;
            padding:14px;
            margin:10px 0;
            border-radius:6px;
          ">

            <strong>
              ${escapeHtml_(item.id)}
              –
              ${escapeHtml_(item.nome)}
            </strong>

            <br><br>

            <strong>Prestador:</strong>
            ${escapeHtml_(item.prestador || "-")}
            <br>

            <strong>Pavimento:</strong>
            ${escapeHtml_(item.pavimento || "-")}
            <br>

            <strong>Localização:</strong>
            ${escapeHtml_(item.localizacao || "-")}

            ${
              item.localDetalhado
                ? `
                  <br>
                  <strong>Local detalhado:</strong>
                  ${escapeHtml_(item.localDetalhado)}
                `
                : ""
            }

            ${
              item.observacaoEquipamento
                ? `

                  <br><br>

                  <strong>
                    Observação do equipamento:
                  </strong>

                  <br>

                  ${escapeHtml_(item.observacaoEquipamento)}

                `
                : ""
            }

          </div>

        `;
      }
    );
  }


  html += `

      <hr style="
        border:0;
        border-top:1px solid #ddd;
        margin-top:30px;
      ">

      <p style="
        color:#777;
        font-size:12px;
      ">
        Relatório gerado pelo QRManut.
        A situação apresentada corresponde ao momento da emissão deste e-mail.
      </p>

    </div>

  `;


  return html;
}


/* ============================================================
 * PDF DO RELATÓRIO – 7.3.4
 * ============================================================ */

function sanitizarNomeArquivoRelatorio_(texto) {

  var nome =
    String(texto || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-zA-Z0-9 _-]/g, "")
      .trim()
      .replace(/\s+/g, "_");

  return nome || "Relatorio";
}


function formatarDataHoraRelatorio_(valor) {

  if (!valor) {
    return "-";
  }

  var data =
    valor instanceof Date
      ? valor
      : new Date(valor);

  if (isNaN(data.getTime())) {
    return String(valor);
  }

  return Utilities.formatDate(
    data,
    Session.getScriptTimeZone(),
    "dd/MM/yyyy HH:mm"
  );
}


function adicionarLinkPdfRelatorio_(body,label,url) {

  if (!url) {
    return;
  }

  var p =
    body.appendParagraph("");

  p.appendText(
    label + ": "
  )
  .setBold(true);

  p.appendText(
    "Abrir arquivo"
  )
  .setLinkUrl(
    String(url)
  );
}


function gerarPdfRelatorioPreventivas_(data,escopo) {

  var s =
    data.summary;

  var nomeBase =
    "QRManut_Relatorio_Preventivas_" +
    data.competencia +
    "_" +
    sanitizarNomeArquivoRelatorio_(
      escopo
    );

  var doc =
    DocumentApp.create(
      nomeBase
    );

  var body =
    doc.getBody();

  body.clear();


  var titulo =
    body.appendParagraph(
      "QRManut – Relatório de Manutenções Preventivas"
    );

  titulo.setHeading(
    DocumentApp.ParagraphHeading.TITLE
  );


  body.appendParagraph(
    "Competência: " +
    data.competenciaDescricao
  );

  body.appendParagraph(
    "Escopo: " +
    escopo
  );

  body.appendParagraph(
    "Gerado em: " +
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "dd/MM/yyyy HH:mm"
    )
  );


  body.appendParagraph(
    "Resumo"
  )
  .setHeading(
    DocumentApp.ParagraphHeading.HEADING1
  );


  var tabelaResumo =
    body.appendTable([
      [
        "Previstas",
        "Realizadas",
        "Pendentes",
        "Conclusão"
      ],
      [
        String(s.previstas),
        String(s.realizadas),
        String(s.pendentes),
        String(s.percentual) + "%"
      ]
    ]);

  for (
    var c = 0;
    c < 4;
    c++
  ) {

    tabelaResumo
      .getRow(0)
      .getCell(c)
      .editAsText()
      .setBold(true);
  }


  body.appendParagraph(
    "Preventivas realizadas"
  )
  .setHeading(
    DocumentApp.ParagraphHeading.HEADING1
  );


  if (!data.realizadas.length) {

    body.appendParagraph(
      "Nenhuma preventiva realizada nesta competência."
    );

  } else {

    data.realizadas.forEach(
      function(item) {

        var registro =
          item.ultimoRegistro || {};

        body.appendParagraph(
          String(item.id || "") +
          " – " +
          String(item.nome || "")
        )
        .setHeading(
          DocumentApp.ParagraphHeading.HEADING2
        );

        body.appendParagraph(
          "Prestador: " +
          (item.prestador || "-")
        );

        body.appendParagraph(
          "Pavimento: " +
          (item.pavimento || "-")
        );

        body.appendParagraph(
          "Localização: " +
          (item.localizacao || "-")
        );

        if (item.localDetalhado) {

          body.appendParagraph(
            "Local detalhado: " +
            item.localDetalhado
          );
        }

        body.appendParagraph(
          "Data da preventiva: " +
          formatarDataHoraRelatorio_(
            registro.data
          )
        );

        body.appendParagraph(
          "Responsável: " +
          (registro.responsavel || "-")
        );

        if (item.observacaoEquipamento) {

          body.appendParagraph(
            "Observação do equipamento: " +
            item.observacaoEquipamento
          );
        }

        if (registro.observacao) {

          body.appendParagraph(
            "Observação da preventiva: " +
            registro.observacao
          );
        }

        adicionarLinkPdfRelatorio_(
          body,
          "Foto / evidência",
          registro.foto
        );

        adicionarLinkPdfRelatorio_(
          body,
          "Assinatura",
          registro.assinatura
        );

        body.appendHorizontalRule();
      }
    );
  }


  body.appendParagraph(
    "Preventivas pendentes"
  )
  .setHeading(
    DocumentApp.ParagraphHeading.HEADING1
  );


  if (!data.pendentes.length) {

    body.appendParagraph(
      "Nenhuma preventiva pendente nesta competência."
    );

  } else {

    data.pendentes.forEach(
      function(item) {

        body.appendParagraph(
          String(item.id || "") +
          " – " +
          String(item.nome || "")
        )
        .setHeading(
          DocumentApp.ParagraphHeading.HEADING2
        );

        body.appendParagraph(
          "Prestador: " +
          (item.prestador || "-")
        );

        body.appendParagraph(
          "Pavimento: " +
          (item.pavimento || "-")
        );

        body.appendParagraph(
          "Localização: " +
          (item.localizacao || "-")
        );

        if (item.localDetalhado) {

          body.appendParagraph(
            "Local detalhado: " +
            item.localDetalhado
          );
        }

        if (item.observacaoEquipamento) {

          body.appendParagraph(
            "Observação do equipamento: " +
            item.observacaoEquipamento
          );
        }

        body.appendHorizontalRule();
      }
    );
  }


  body.appendParagraph(
    "Relatório gerado automaticamente pelo QRManut. " +
    "A situação apresentada corresponde ao momento da emissão."
  );


  doc.saveAndClose();

  var arquivoTemporario =
    DriveApp.getFileById(
      doc.getId()
    );

  try {

    return arquivoTemporario
      .getAs(
        MimeType.PDF
      )
      .setName(
        nomeBase + ".pdf"
      );

  } finally {

    /*
     * O Google Doc é utilizado apenas para montar o PDF.
     * O relatório enviado permanece no e-mail como anexo.
     */
    arquivoTemporario.setTrashed(
      true
    );
  }
}


/* ============================================================
 * CORPO DO E-MAIL DO RELATÓRIO – 7.3.4
 * ============================================================ */

function montarHtmlCorpoEmailRelatorio_(data,escopo) {

  var s =
    data.summary;

  return `

    <div style="
      font-family:Arial,sans-serif;
      color:#222;
      max-width:720px;
      line-height:1.55;
    ">

      <p>Olá,</p>

      <p>
        Segue em anexo o
        <strong>Relatório de Manutenções Preventivas do QRManut</strong>,
        referente à competência
        <strong>${escapeHtml_(data.competenciaDescricao)}</strong>.
      </p>

      <p>
        O relatório apresenta a situação das manutenções preventivas
        previstas para o período, incluindo as atividades realizadas e
        as que permanecem pendentes no momento da emissão.
      </p>

      <p>
        <strong>Escopo:</strong>
        ${escapeHtml_(escopo)}
      </p>

      <table
        cellpadding="9"
        cellspacing="0"
        style="
          border-collapse:collapse;
          margin:16px 0;
          width:100%;
          max-width:620px;
        "
      >

        <tr>
          <td style="border:1px solid #ddd;text-align:center">
            <strong>${s.previstas}</strong><br>Previstas
          </td>
          <td style="border:1px solid #ddd;text-align:center">
            <strong>${s.realizadas}</strong><br>Realizadas
          </td>
          <td style="border:1px solid #ddd;text-align:center">
            <strong>${s.pendentes}</strong><br>Pendentes
          </td>
          <td style="border:1px solid #ddd;text-align:center">
            <strong>${s.percentual}%</strong><br>Conclusão
          </td>
        </tr>

      </table>

      <p>
        O detalhamento completo dos equipamentos, registros realizados,
        pendências, observações e evidências disponíveis encontra-se no
        <strong>arquivo PDF anexo</strong>.
      </p>

      <p>
        Atenciosamente,<br>
        <strong>QRManut – Sistema de Gestão de Manutenção</strong>
      </p>

      <p style="color:#777;font-size:12px">
        Mensagem automática. A situação apresentada corresponde ao momento
        da emissão do relatório.
      </p>

    </div>

  `;
}


/* ============================================================
 * ENVIO DO RELATÓRIO
 * ============================================================ */

function enviarRelatorioPreventivas_(body) {

  var sessao =
    validarSessaoPreventiva_(
      body.preventiveSessionToken
    );

  var competencia =
    resolverCompetencia_(
      body.competencia
    );

  var filtroPrestador =
    String(
      body.reportProvider || ""
    ).trim();


  if (
    !isWideScopeSession_(sessao)
  ) {

    filtroPrestador =
      sessao.prestador;
  }


  var config =
    resolverConfigRelatorio_(
      sessao,
      filtroPrestador
    );


  if (
    !config.permitido
  ) {

    throw new Error(
      "O envio de relatório não está habilitado para este prestador."
    );
  }


  if (
    !config.emails.length
  ) {

    throw new Error(
      "Nenhum e-mail de relatório está cadastrado."
    );
  }


  var data =
    getMonthlyPreventiveControl_(
      competencia,
      sessao,
      filtroPrestador
    );


  var assunto =

    "[QRManut] Relatório Preventivas - " +
    data.competenciaDescricao +
    " - " +
    config.escopo;


  var pdf =
    gerarPdfRelatorioPreventivas_(
      data,
      config.escopo
    );


  var html =
    montarHtmlCorpoEmailRelatorio_(
      data,
      config.escopo
    );


  var texto =

    "Olá,\n\n" +

    "Segue em anexo o Relatório de Manutenções Preventivas do QRManut, referente à competência " +
    data.competenciaDescricao +
    ".\n\n" +

    "O relatório apresenta a situação das manutenções preventivas previstas para o período, incluindo as atividades realizadas e as que permanecem pendentes no momento da emissão.\n\n" +

    "Escopo: " +
    config.escopo +
    "\n\n" +

    "Resumo da competência:\n" +

    "Previstas: " +
    data.summary.previstas +
    "\n" +

    "Realizadas: " +
    data.summary.realizadas +
    "\n" +

    "Pendentes: " +
    data.summary.pendentes +
    "\n" +

    "Conclusão: " +
    data.summary.percentual +
    "%\n\n" +

    "O detalhamento completo encontra-se no arquivo PDF anexo.\n\n" +

    "Atenciosamente,\n" +
    "QRManut – Sistema de Gestão de Manutenção";


  MailApp.sendEmail({

    to:
      config.emails.join(","),

    subject:
      assunto,

    body:
      texto,

    htmlBody:
      html,

    attachments:[
      pdf
    ],

    name:
      "QRManut"

  });


  preparePreventiveReportLogSheet_()
    .appendRow([

      new Date(),
      competencia,
      config.escopo,
      data.summary.previstas,
      data.summary.realizadas,
      data.summary.pendentes,
      data.summary.percentual + "%",
      sessao.usuario,
      sessao.perfil,
      config.emailString

    ]);


  audit741_(
    sessao,
    "RELATORIO_ENVIADO",
    "RELATORIO_PREVENTIVA",
    competencia,
    "",
    "SUCESSO",
    "Escopo: "+config.escopo+" | Destino: "+config.emailString
  );

  return {

    ok:true,

    competencia:
      competencia,

    competenciaDescricao:
      data.competenciaDescricao,

    escopo:
      config.escopo,

    email:
      config.emailString,

    summary:
      data.summary

  };
}


/* ============================================================
 * BODY POST
 * ============================================================ */

function readPostBody_(e) {

  var p =
    e && e.parameter
      ? e.parameter
      : {};

  return {

    action:
      p.action || "",

    systemSessionToken:
      p.systemSessionToken || "",

    systemUsername:
      p.systemUsername || "",

    systemPassword:
      p.systemPassword || "",

    authToken:
      p.authToken || "",

    authTokenType:
      p.authTokenType || "",

    newPassword:
      p.newPassword || "",

    confirmPassword:
      p.confirmPassword || "",

    recoveryIdentifier:
      p.recoveryIdentifier || "",

    userId:
      p.userId || "",

    userName:
      p.userName || "",

    userLogin:
      p.userLogin || "",

    userEmail:
      p.userEmail || "",

    userProviderId:
      p.userProviderId || "",

    userProfile:
      p.userProfile || "",

    userStatus:
      p.userStatus || "",

    companyId:p.companyId || "",
    companyName:p.companyName || "",
    companyTradeName:p.companyTradeName || "",
    companyCnpj:p.companyCnpj || "",
    companyMaintenanceEmail:p.companyMaintenanceEmail || "",
    companyAdminEmail:p.companyAdminEmail || "",
    companyLogo:p.companyLogo || "",
    companyPrimaryColor:p.companyPrimaryColor || "",
    companyTimezone:p.companyTimezone || "",
    companySystemName:p.companySystemName || "",
    companyActive:p.companyActive || "",
    companyMainUrl:p.companyMainUrl || "",
    companyReportsEmail:p.companyReportsEmail || "",
    companyNotes:p.companyNotes || "",

    providerId:p.providerId || "",
    providerName:p.providerName || "",
    providerTradeName:p.providerTradeName || "",
    providerActive:p.providerActive || "",
    providerRequireSignature:p.providerRequireSignature || "",
    providerPhotoRequired:p.providerPhotoRequired || "",
    providerObservationRequired:p.providerObservationRequired || "",
    providerCanPreventive:p.providerCanPreventive || "",
    providerCanOccurrence:p.providerCanOccurrence || "",
    providerNotifyOccurrence:p.providerNotifyOccurrence || "",
    providerOccurrenceEmail:p.providerOccurrenceEmail || "",
    providerSendReport:p.providerSendReport || "",
    providerReportEmail:p.providerReportEmail || "",
    providerNotes:p.providerNotes || "",
    documentTitle:p.documentTitle || "",
    documentType:p.documentType || "",
    documentDiscipline:p.documentDiscipline || "",
    documentFloor:p.documentFloor || "",
    documentEnvironment:p.documentEnvironment || "",
    documentProvider:p.documentProvider || "",
    documentSubject:p.documentSubject || "",
    documentRevision:p.documentRevision || "",
    documentNotes:p.documentNotes || "",
    documentAssetId:p.documentAssetId || "",
    documentFileName:p.documentFileName || "",
    documentMime:p.documentMime || "",
    documentBase64:p.documentBase64 || "",
    catalogCategoryId:p.catalogCategoryId || "",
    catalogCategoryPt:p.catalogCategoryPt || "",
    catalogCategoryEn:p.catalogCategoryEn || "",
    catalogCategoryActive:p.catalogCategoryActive || "",
    catalogCategoryOrder:p.catalogCategoryOrder || "",
    catalogComponentId:p.catalogComponentId || "",
    catalogComponentCategoryId:p.catalogComponentCategoryId || "",
    catalogComponentPt:p.catalogComponentPt || "",
    catalogComponentEn:p.catalogComponentEn || "",
    catalogComponentActive:p.catalogComponentActive || "",
    catalogComponentOrder:p.catalogComponentOrder || "",

    token:
      p.token || "",

    id:
      p.id || "",

    reportadoPor:
      p.reportadoPor || "",

    contato:
      p.contato || "",

    descricao:
      p.descricao || "",

    categoriaOcorrencia:
      p.categoriaOcorrencia || "",

    componenteAfetado:
      p.componenteAfetado || "",

    fotoBase64:
      p.fotoBase64 || "",

    fotoNome:
      p.fotoNome || "",

    fotoMime:
      p.fotoMime || "",

    ocorrencia:
      p.ocorrencia || "",

    status:
      p.status || "",

    responsavel:
      p.responsavel || "",

    solucao:
      p.solucao || "",

    alteradoPor:
      p.alteradoPor || "",

    descricaoOcorrencia:
      p.descricaoOcorrencia || "",

    categoriaOcorrenciaEdit:
      p.categoriaOcorrenciaEdit || "",

    componenteAfetadoEdit:
      p.componenteAfetadoEdit || "",

    fotoOcorrenciaBase64:
      p.fotoOcorrenciaBase64 || "",

    fotoOcorrenciaNome:
