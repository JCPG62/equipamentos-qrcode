function atualizarDropdownLocalizacaoLinha_(sh,linha) {

  var pavimento =
    String(
      sh.getRange(
        linha,
        25
      )
      .getValue() ||
      ""
    )
    .trim();

  var celula =
    sh.getRange(
      linha,
      12
    );

  var opcoes =
    getLocalizacoesPorPavimento_()[
      pavimento
    ];

  if (!opcoes) {

    celula.clearDataValidations();

    return;
  }

  var regra =
    SpreadsheetApp
      .newDataValidation()
      .requireValueInList(
        opcoes,
        true
      )
      .setAllowInvalid(
        false
      )
      .build();

  celula.setDataValidation(
    regra
  );
}


function configurarDropdownsDependentesLocalizacao() {

  var sh =
    getSpreadsheet_()
      .getSheetByName(
        CONFIG.EQUIPMENT_SHEET
      );

  if (!sh) {

    return;
  }

  for (
    var i = 2;
    i <= sh.getLastRow();
    i++
  ) {

    atualizarDropdownLocalizacaoLinha_(
      sh,
      i
    );
  }
}


/* ============================================================
 * ON EDIT
 * ============================================================ */

function onEdit(e) {

  if (
    !e ||
    !e.range
  ) {

    return;
  }

  var sh =
    e.range.getSheet();

  var row =
    e.range.getRow();

  var col =
    e.range.getColumn();

  if (
    row <= 1
  ) {

    return;
  }

  if (
    sh.getName() ===
    CONFIG.EQUIPMENT_SHEET &&
    col === 25
  ) {

    atualizarDropdownLocalizacaoLinha_(
      sh,
      row
    );
  }

  if (
    sh.getName() ===
    CONFIG.HISTORY_SHEET &&
    col === 9
  ) {

    var status =
      String(
        e.value || ""
      );

    var inicio =
      sh.getRange(
        row,
        11
      );

    var conclusao =
      sh.getRange(
        row,
        12
      );

    if (
      (
        status === "Em atendimento" ||
        status === "Aguardando peça" ||
        status === "Concluída"
      ) &&
      !inicio.getValue()
    ) {

      inicio.setValue(
        new Date()
      );
    }

    if (
      status === "Concluída" &&
      !conclusao.getValue()
    ) {

      conclusao.setValue(
        new Date()
      );
    }
  }
}


/* ============================================================
 * CONFIGURAÇÃO 7.2
 * ============================================================ */

function configurarAcessosPreventiva72() {

  var sh =
    preparePreventiveAccessSheet_();


  var regraPerfil =
    SpreadsheetApp
      .newDataValidation()
      .requireValueInList(
        [
          "MASTER",
          "PRESTADOR"
        ],
        true
      )
      .setAllowInvalid(
        false
      )
      .build();


  var regraSN =
    SpreadsheetApp
      .newDataValidation()
      .requireValueInList(
        [
          "Sim",
          "Não"
        ],
        true
      )
      .setAllowInvalid(
        false
      )
      .build();


  sh.getRange(
    2,
    4,
    500,
    1
  )
  .setDataValidation(
    regraPerfil
  );


  /*
   * E até I
   */

  sh.getRange(
    2,
    5,
    500,
    5
  )
  .setDataValidation(
    regraSN
  );


  /*
   * K = Enviar Relatório
   */

  sh.getRange(
    2,
    11,
    500,
    1
  )
  .setDataValidation(
    regraSN
  );


  if (
    sh.getLastRow() === 1
  ) {

    sh.appendRow([

      "PNCQ",
      "pncq",
      "",
      "MASTER",
      "Sim",
      "Não",
      "Não",
      "Não",
      "Não",
      "",
      "Sim",
      CONFIG.NOTIFICATION_EMAIL_TO

    ]);
  }


  sh.autoResizeColumns(
    1,
    12
  );
}


