/* ============================================================
 * DRIVE
 * ============================================================ */

function getOrCreateFolder_(name) {

  var folders =
    DriveApp.getFoldersByName(
      name
    );

  return folders.hasNext()
    ? folders.next()
    : DriveApp.createFolder(
        name
      );
}


function aplicarPermissaoFoto_(file) {

  if (
    !CONFIG.PHOTO_PUBLIC_BY_LINK
  ) {

    return;
  }

  try {

    file.setSharing(
      DriveApp.Access.ANYONE_WITH_LINK,
      DriveApp.Permission.VIEW
    );

  } catch(error) {

    Logger.log(
      error
    );
  }
}


function createBlobFromBase64_(
  base64Raw,
  mimeRaw,
  nomeRaw,
  maxBytes
) {

  var raw =
    String(
      base64Raw || ""
    ).trim();

  if (!raw) {

    return null;
  }

  var base64 =
    raw;

  var mime =
    String(
      mimeRaw ||
      "image/jpeg"
    );

  var match =
    raw.match(
      /^data:([^;]+);base64,(.+)$/s
    );

  if (match) {

    mime =
      match[1];

    base64 =
      match[2];
  }

  var bytes =
    Utilities.base64Decode(
      base64
    );

  if (
    bytes.length >
    maxBytes
  ) {

    throw new Error(
      "Arquivo acima do limite permitido."
    );
  }

  return Utilities.newBlob(
    bytes,
    mime,
    String(
      nomeRaw ||
      "arquivo"
    )
  );
}


function savePhotoFromBase64_(
  base64Raw,
  mimeRaw,
  nomeRaw,
  equipmentId,
  occurrence,
  suffix
) {

  var blob =
    createBlobFromBase64_(
      base64Raw,
      mimeRaw,
      nomeRaw,
      CONFIG.MAX_PHOTO_BYTES
    );

  if (!blob) {

    return {
      blob:null,
      url:""
    };
  }

  blob.setName(

    occurrence +
    "_" +
    normId_(equipmentId) +
    "_" +
    suffix +
    "_" +
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyyyMMdd_HHmmss"
    ) +
    ".jpg"

  );

  var file =
    getOrCreateFolder_(
      CONFIG.PHOTO_FOLDER_NAME
    )
    .createFile(
      blob
    );

  aplicarPermissaoFoto_(
    file
  );

  return {

    blob:
      blob,

    url:
      file.getUrl()

  };
}


