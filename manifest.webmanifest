/* Leitura das credenciais legadas apenas para migração 7.4.0. */
function getSystemAccessSheet_() {
  var ss=getSpreadsheet_();
  var sh=ss.getSheetByName(CONFIG.SYSTEM_ACCESS_SHEET);
  if(!sh)sh=ss.insertSheet(CONFIG.SYSTEM_ACCESS_SHEET);
  return sh;
}

function prepareSystemAccessSheet_() {
  var sh=getSystemAccessSheet_();
  var headers=["Prestador","Usuário","Senha","Perfil","Nome","Ativo"];
  sh.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight("bold");
  sh.setFrozenRows(1);
  return sh;
}

function readSystemAccess_() {
  var values=prepareSystemAccessSheet_().getDataRange().getDisplayValues();
  var result=[];
  for(var i=1;i<values.length;i++){
    var r=values[i];
    if(!String(r[0]||"").trim()&&!String(r[1]||"").trim())continue;
    result.push({prestador:String(r[0]||"").trim(),usuario:String(r[1]||"").trim(),senha:String(r[2]||""),perfil:String(r[3]||"PRESTADOR").trim().toUpperCase(),nome:String(r[4]||"").trim(),ativo:normalizarBusca_(r[5]||"Sim")!=="nao"});
  }
  return result;
}

function getUsersSheet_(){var ss=getSpreadsheet_(),sh=ss.getSheetByName(CONFIG.USERS_SHEET);if(!sh)sh=ss.insertSheet(CONFIG.USERS_SHEET);return sh;}
function prepareUsersSheet_(){var sh=getUsersSheet_();var h=["ID Usuário","Nome","Usuário/Login","E-mail","ID Prestador","Perfil","Senha Hash","Salt","Status","Trocar Senha","Tentativas Inválidas","Bloqueado Até","Último Login","Criado Em","Criado Por","Última Alteração","Data de Desativação","Versão Sessão"];sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");sh.setFrozenRows(1);return sh;}
function readUsers_(){var v=prepareUsersSheet_().getDataRange().getValues(),r=[];for(var i=1;i<v.length;i++){var x=v[i];if(!String(x[0]||"").trim()&&!String(x[2]||"").trim()&&!String(x[3]||"").trim())continue;r.push({row:i+1,idUsuario:String(x[0]||"").trim(),nome:String(x[1]||"").trim(),usuario:String(x[2]||"").trim(),email:String(x[3]||"").trim(),idPrestador:String(x[4]||"").trim(),perfil:String(x[5]||"CONSULTA").trim().toUpperCase(),senhaHash:String(x[6]||"").trim(),salt:String(x[7]||"").trim(),status:String(x[8]||"Convite pendente").trim(),trocarSenha:sim_(x[9]),tentativasInvalidas:Number(x[10]||0),bloqueadoAte:x[11]||"",ultimoLogin:x[12]||"",criadoEm:x[13]||"",criadoPor:String(x[14]||"").trim(),ultimaAlteracao:x[15]||"",dataDesativacao:x[16]||"",versaoSessao:Number(x[17]||1)});}return r;}
function getUserById_(id){var a=String(id||"").trim().toUpperCase();return readUsers_().find(function(u){return String(u.idUsuario||"").toUpperCase()===a;})||null;}
function getUserByIdentifier_(id){var a=normalizarBusca_(id);if(!a)return null;return readUsers_().find(function(u){return normalizarBusca_(u.usuario)===a||normalizarBusca_(u.email)===a;})||null;}
function nextUserId_(){var n=0;readUsers_().forEach(function(u){var m=String(u.idUsuario||"").match(/^USR-(\d+)$/i);if(m)n=Math.max(n,Number(m[1]));});return "USR-"+Utilities.formatString("%04d",n+1);}

function getProvidersSheet_(){var ss=getSpreadsheet_(),sh=ss.getSheetByName(CONFIG.PROVIDERS_SHEET);if(!sh)sh=ss.insertSheet(CONFIG.PROVIDERS_SHEET);return sh;}
function prepareProvidersSheet_(){var sh=getProvidersSheet_();var h=["ID Prestador","Nome/Razão Social","Nome Fantasia","Ativo","Exigir Assinatura","Foto Obrigatória","Observação Obrigatória","Pode Registrar Preventiva","Pode Atender OC","Notificar OC","E-mail OC","Enviar Relatório","E-mail Relatório","Observações"];sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");sh.setFrozenRows(1);return sh;}

function getCompanyConfigSheet_(){var ss=getSpreadsheet_(),sh=ss.getSheetByName(CONFIG.COMPANY_CONFIG_SHEET);if(!sh)sh=ss.insertSheet(CONFIG.COMPANY_CONFIG_SHEET);return sh;}
function prepareCompanyConfigSheet_(){
  var sh=getCompanyConfigSheet_();
  var h=["ID Empresa","Nome da Empresa","Nome Fantasia","CNPJ","E-mail de Manutenção","E-mail Administrativo","Logo","Cor Principal","Fuso Horário","Nome do Sistema","Empresa Ativa","URL Principal","E-mail Relatórios","Observações"];
  sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");sh.setFrozenRows(1);
  if(sh.getLastRow()<2)sh.getRange(2,1,1,h.length).setValues([["EMP-0001","PNCQ","PNCQ","",CONFIG.NOTIFICATION_EMAIL_CC||"",CONFIG.NOTIFICATION_EMAIL_CC||"","","#0b315e",Session.getScriptTimeZone()||"America/Sao_Paulo","QRManut","Sim",CONFIG.APP_URL||"",CONFIG.NOTIFICATION_EMAIL_CC||"","Configuração inicial 7.4.2"]]);
  sh.getRange(2,11,1000,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(["Sim","Não"],true).setAllowInvalid(false).build());
  return sh;
}
function getCompanyConfig_(){
  var cached=cacheGetJson_("v743_empresa");
  if(cached)return cached;

  var r=prepareCompanyConfigSheet_().getRange(2,1,1,14).getDisplayValues()[0];
  var c={
    idEmpresa:r[0]||"EMP-0001",
    nomeEmpresa:r[1]||"",
    nomeFantasia:r[2]||"",
    cnpj:r[3]||"",
    emailManutencao:r[4]||"",
    emailAdministrativo:r[5]||"",
    logo:r[6]||"",
    corPrincipal:r[7]||"#0b315e",
    fusoHorario:r[8]||"America/Sao_Paulo",
    nomeSistema:r[9]||"QRManut",
    empresaAtiva:normalizarBusca_(r[10]||"Sim")!=="nao",
    urlPrincipal:r[11]||"",
    emailRelatorios:r[12]||"",
    observacoes:r[13]||""
  };
  cachePutJson_("v743_empresa",c);
  return c;
}
function getPublicAppConfig_(){var c=getCompanyConfig_();return{ok:true,app:{nomeSistema:c.nomeSistema,nomeEmpresa:c.nomeFantasia||c.nomeEmpresa,logo:c.logo,corPrincipal:c.corPrincipal,empresaAtiva:c.empresaAtiva}};}
function updateCompanyConfig_(b,s){
  if(!s||s.perfil!=="MASTER")throw new Error("Somente MASTER pode alterar a configuração da empresa.");
  var ant=getCompanyConfig_(),sh=prepareCompanyConfigSheet_();
  var n={idEmpresa:String(b.companyId||ant.idEmpresa||"EMP-0001").trim(),nomeEmpresa:String(b.companyName||"").trim(),nomeFantasia:String(b.companyTradeName||"").trim(),cnpj:String(b.companyCnpj||"").trim(),emailManutencao:String(b.companyMaintenanceEmail||"").trim(),emailAdministrativo:String(b.companyAdminEmail||"").trim(),logo:String(b.companyLogo||"").trim(),corPrincipal:String(b.companyPrimaryColor||"#0b315e").trim()||"#0b315e",fusoHorario:String(b.companyTimezone||"America/Sao_Paulo").trim()||"America/Sao_Paulo",nomeSistema:String(b.companySystemName||"QRManut").trim()||"QRManut",empresaAtiva:sim_(b.companyActive),urlPrincipal:String(b.companyMainUrl||"").trim(),emailRelatorios:String(b.companyReportsEmail||"").trim(),observacoes:String(b.companyNotes||"").trim()};
  if(!n.nomeEmpresa)throw new Error("Informe o nome da empresa.");
  sh.getRange(2,1,1,14).setValues([[n.idEmpresa,n.nomeEmpresa,n.nomeFantasia,n.cnpj,n.emailManutencao,n.emailAdministrativo,n.logo,n.corPrincipal,n.fusoHorario,n.nomeSistema,n.empresaAtiva?"Sim":"Não",n.urlPrincipal,n.emailRelatorios,n.observacoes]]);
  invalidateCompanyCache_();audit741_(s,"CONFIGURACAO_ALTERADA","CONFIGURACAO_EMPRESA",n.idEmpresa,"","SUCESSO","Configuração institucional atualizada.",ant,n);
  return{ok:true,config:n};
}
function listProvidersAdmin_(s){if(!s||s.perfil!=="MASTER")throw new Error("Somente MASTER pode administrar prestadores.");return readProviders_();}
function createProvider_(b,s){
  if(!s||s.perfil!=="MASTER")throw new Error("Somente MASTER pode cadastrar prestadores.");
  var nome=String(b.providerName||"").trim(),fant=String(b.providerTradeName||"").trim();if(!nome)throw new Error("Informe o nome/razão social.");
  if(getProviderByName_(fant||nome))throw new Error("Já existe prestador com esse nome.");
  var id=nextProviderId_();
  prepareProvidersSheet_().appendRow([id,nome,fant||nome,sim_(b.providerActive)?"Sim":"Não",sim_(b.providerRequireSignature)?"Sim":"Não",sim_(b.providerPhotoRequired)?"Sim":"Não",sim_(b.providerObservationRequired)?"Sim":"Não",sim_(b.providerCanPreventive)?"Sim":"Não",sim_(b.providerCanOccurrence)?"Sim":"Não",sim_(b.providerNotifyOccurrence)?"Sim":"Não",String(b.providerOccurrenceEmail||"").trim(),sim_(b.providerSendReport)?"Sim":"Não",String(b.providerReportEmail||"").trim(),String(b.providerNotes||"").trim()]);
  invalidateProviderCache_();var p=getProviderById_(id);audit741_(s,"PRESTADOR_CRIADO","PRESTADOR",id,"","SUCESSO","Prestador cadastrado.","",p);return{ok:true,provider:p};
}
function updateProvider_(b,s){
  if(!s||s.perfil!=="MASTER")throw new Error("Somente MASTER pode alterar prestadores.");
  var p=getProviderById_(b.providerId);if(!p)throw new Error("Prestador não encontrado.");var ant=JSON.parse(JSON.stringify(p)),sh=prepareProvidersSheet_();
  var n={idPrestador:p.idPrestador,nome:String(b.providerName||"").trim(),nomeFantasia:String(b.providerTradeName||"").trim(),ativo:sim_(b.providerActive),exigirAssinatura:sim_(b.providerRequireSignature),fotoObrigatoria:sim_(b.providerPhotoRequired),observacaoObrigatoria:sim_(b.providerObservationRequired),podeRegistrarPreventiva:sim_(b.providerCanPreventive),podeAtenderOC:sim_(b.providerCanOccurrence),notificarOC:sim_(b.providerNotifyOccurrence),emailOC:String(b.providerOccurrenceEmail||"").trim(),enviarRelatorio:sim_(b.providerSendReport),emailRelatorio:String(b.providerReportEmail||"").trim(),observacoes:String(b.providerNotes||"").trim()};
  if(!n.nome)throw new Error("Informe o nome/razão social.");
  sh.getRange(p.row,1,1,14).setValues([[n.idPrestador,n.nome,n.nomeFantasia||n.nome,n.ativo?"Sim":"Não",n.exigirAssinatura?"Sim":"Não",n.fotoObrigatoria?"Sim":"Não",n.observacaoObrigatoria?"Sim":"Não",n.podeRegistrarPreventiva?"Sim":"Não",n.podeAtenderOC?"Sim":"Não",n.notificarOC?"Sim":"Não",n.emailOC,n.enviarRelatorio?"Sim":"Não",n.emailRelatorio,n.observacoes]]);
  invalidateProviderCache_();audit741_(s,"PRESTADOR_ALTERADO","PRESTADOR",p.idPrestador,"","SUCESSO","Regras operacionais atualizadas.",ant,n);return{ok:true,provider:getProviderById_(p.idPrestador)};
}
function readProviders_(){
  var cached=cacheGetJson_("v743_prestadores");
  if(cached)return cached;

  var sh=prepareProvidersSheet_();
  var lastRow=sh.getLastRow();
  if(lastRow<=1){
    cachePutJson_("v743_prestadores",[]);
    return [];
  }

  var v=sh.getRange(1,1,lastRow,14).getDisplayValues(),r=[];
  for(var i=1;i<v.length;i++){
    var x=v[i];
    if(!String(x[0]||"").trim()&&!String(x[1]||"").trim())continue;
    r.push({
      row:i+1,
      idPrestador:String(x[0]||"").trim(),
      nome:String(x[1]||"").trim(),
      nomeFantasia:String(x[2]||"").trim(),
      ativo:normalizarBusca_(x[3]||"Sim")!=="nao",
      exigirAssinatura:sim_(x[4]),
      fotoObrigatoria:sim_(x[5]),
      observacaoObrigatoria:sim_(x[6]),
      podeRegistrarPreventiva:normalizarBusca_(x[7]||"Sim")!=="nao",
      podeAtenderOC:normalizarBusca_(x[8]||"Sim")!=="nao",
      notificarOC:sim_(x[9]),
      emailOC:String(x[10]||"").trim(),
      enviarRelatorio:sim_(x[11]),
      emailRelatorio:String(x[12]||"").trim(),
      observacoes:String(x[13]||"").trim()
    });
  }

  cachePutJson_("v743_prestadores",r);
  return r;
}
function getProviderById_(id){var a=String(id||"").trim().toUpperCase();return readProviders_().find(function(p){return String(p.idPrestador||"").toUpperCase()===a;})||null;}
function getProviderByName_(nome){var a=normalizarBusca_(nome);if(!a)return null;return readProviders_().find(function(p){return normalizarBusca_(p.nome)===a||normalizarBusca_(p.nomeFantasia)===a;})||null;}
function nextProviderId_(){var n=0;readProviders_().forEach(function(p){var m=String(p.idPrestador||"").match(/^PRE-(\d+)$/i);if(m)n=Math.max(n,Number(m[1]));});return "PRE-"+Utilities.formatString("%04d",n+1);}
function providerIdFromName_(nome){var p=getProviderByName_(nome);return p?p.idPrestador:"";}

function prepareUserTokensSheet_(){var ss=getSpreadsheet_(),sh=ss.getSheetByName(CONFIG.USER_TOKENS_SHEET);if(!sh)sh=ss.insertSheet(CONFIG.USER_TOKENS_SHEET);var h=["ID Token","ID Usuário","Tipo","Token Hash","Expira Em","Usado Em","Criado Em"];sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");sh.setFrozenRows(1);return sh;}
function prepareAuditSheet_(){var ss=getSpreadsheet_(),sh=ss.getSheetByName(CONFIG.AUDIT_SHEET);if(!sh)sh=ss.insertSheet(CONFIG.AUDIT_SHEET);var h=["Data/Hora","ID Usuário","Nome do Usuário","Perfil","Ação","Tipo de Registro","ID do Registro","ID do Ativo","Valor Anterior","Valor Novo","Resultado","Detalhes"];sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");sh.setFrozenRows(1);return sh;}
function audit740_(u,acao,tipo,idRegistro,idAtivo,resultado,detalhes,anterior,novo){try{u=u||{};prepareAuditSheet_().appendRow([new Date(),u.idUsuario||"",u.nome||"",u.perfil||"",acao||"",tipo||"",idRegistro||"",idAtivo||"",anterior||"",novo||"",resultado||"",detalhes||""]);}catch(e){Logger.log("Falha auditoria: "+e);}}

function getSecurityPepper_(){var p=PropertiesService.getScriptProperties(),v=p.getProperty("QRMANUT_AUTH_PEPPER");if(!v){v=Utilities.getUuid().replace(/-/g,"")+Utilities.getUuid().replace(/-/g,"");p.setProperty("QRMANUT_AUTH_PEPPER",v);}return v;}
function randomSalt_(){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,Utilities.getUuid()+Utilities.getUuid()+Date.now(),Utilities.Charset.UTF_8)).replace(/=+$/,"");}
function hashPassword740_(senha,salt,rounds){var s=String(senha||"")+"|"+String(salt||"")+"|"+getSecurityPepper_(),out=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8);for(var i=1;i<rounds;i++)out=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,out);return Utilities.base64EncodeWebSafe(out).replace(/=+$/,"");}
function validatePasswordPolicy_(s){s=String(s||"");if(s.length<10)throw new Error("A senha deve possuir pelo menos 10 caracteres.");if(!/[A-Z]/.test(s))throw new Error("Inclua ao menos uma letra maiúscula.");if(!/[a-z]/.test(s))throw new Error("Inclua ao menos uma letra minúscula.");if(!/[0-9]/.test(s))throw new Error("Inclua ao menos um número.");if(!/[^A-Za-z0-9]/.test(s))throw new Error("Inclua ao menos um caractere especial.");}
function createPasswordHash_(senha,salt){var n=CONFIG.PASSWORD_HASH_ROUNDS;return "QRM-SHA256$"+n+"$"+hashPassword740_(senha,salt,n);}
function verifyPassword_(senha,salt,stored){var p=String(stored||"").split("$");if(p.length!==3||p[0]!=="QRM-SHA256")return false;var n=Number(p[1]);return !!n&&createPasswordHashWithRounds_(senha,salt,n)===stored;}
function createPasswordHashWithRounds_(senha,salt,n){return "QRM-SHA256$"+n+"$"+hashPassword740_(senha,salt,n);}
function hashAuthToken_(t){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(t||"")+getSecurityPepper_(),Utilities.Charset.UTF_8)).replace(/=+$/,"");}
function gerarTokenUsuario_(id,tipo,ms){var raw=Utilities.getUuid().replace(/-/g,"")+Utilities.getUuid().replace(/-/g,"");prepareUserTokensSheet_().appendRow(["TKN-"+Utilities.getUuid().slice(0,8).toUpperCase(),id,tipo,hashAuthToken_(raw),new Date(Date.now()+ms),"",new Date()]);return raw;}
function invalidarTokensUsuario_(id){var sh=prepareUserTokensSheet_(),v=sh.getDataRange().getValues();for(var i=1;i<v.length;i++)if(String(v[i][1]||"")===String(id||"")&&!v[i][5])sh.getRange(i+1,6).setValue(new Date());}
function localizarTokenUsuario_(raw,tipo){var v=prepareUserTokensSheet_().getDataRange().getValues(),h=hashAuthToken_(raw);for(var i=1;i<v.length;i++){var r=v[i];if(String(r[2]||"")!==tipo||String(r[3]||"")!==h)continue;if(r[5])throw new Error("Este link já foi utilizado.");var d=r[4] instanceof Date?r[4]:new Date(r[4]);if(isNaN(d.getTime())||d.getTime()<Date.now())throw new Error("Este link expirou.");return {row:i+1,idUsuario:String(r[1]||"")};}throw new Error("Link inválido ou expirado.");}
function montarLinkToken_(tipo,raw){return CONFIG.APP_URL+"?"+(tipo==="ATIVACAO"?"activate":"reset")+"="+encodeURIComponent(raw);}
function enviarConviteUsuario_(u){if(!u.email)throw new Error("O usuário não possui e-mail cadastrado.");invalidarTokensUsuario_(u.idUsuario);var raw=gerarTokenUsuario_(u.idUsuario,"ATIVACAO",CONFIG.INVITE_TOKEN_HOURS*3600000),link=montarLinkToken_("ATIVACAO",raw);MailApp.sendEmail({to:u.email,subject:"[QRManut] Ative seu acesso",body:"Olá "+(u.nome||u.usuario)+",\n\nCrie sua senha do QRManut pelo link:\n"+link+"\n\nO link expira em "+CONFIG.INVITE_TOKEN_HOURS+" horas.",name:"QRManut"});Logger.log("Convite: "+link);return link;}
function solicitarRecuperacaoSenha_(id){var u=getUserByIdentifier_(id);if(!u||normalizarBusca_(u.status)==="inativo"||!u.email)return {ok:true,message:"Se o cadastro existir, as instruções serão enviadas por e-mail."};invalidarTokensUsuario_(u.idUsuario);var raw=gerarTokenUsuario_(u.idUsuario,"RESET",CONFIG.RESET_TOKEN_MINUTES*60000),link=montarLinkToken_("RESET",raw);MailApp.sendEmail({to:u.email,subject:"[QRManut] Redefinição de senha",body:"Olá "+(u.nome||u.usuario)+",\n\nUse o link para redefinir sua senha:\n"+link+"\n\nO link expira em "+CONFIG.RESET_TOKEN_MINUTES+" minutos.",name:"QRManut"});return {ok:true,message:"Se o cadastro existir, as instruções serão enviadas por e-mail."};}
function validarTokenPublico_(raw,tipo){var t=localizarTokenUsuario_(raw,tipo),u=getUserById_(t.idUsuario);if(!u)throw new Error("Usuário não encontrado.");return {ok:true,tipo:tipo,usuario:{idUsuario:u.idUsuario,nome:u.nome,usuario:u.usuario,email:u.email}};}
function definirSenhaPorToken_(b){var tipo=String(b.authTokenType||"").toUpperCase()==="RESET"?"RESET":"ATIVACAO",t=localizarTokenUsuario_(b.authToken||"",tipo),u=getUserById_(t.idUsuario);if(!u)throw new Error("Usuário não encontrado.");if(normalizarBusca_(u.status)==="inativo")throw new Error("Usuário inativo.");validatePasswordPolicy_(b.newPassword);if(String(b.newPassword||"")!==String(b.confirmPassword||""))throw new Error("As senhas não conferem.");var salt=randomSalt_(),hash=createPasswordHash_(b.newPassword,salt),sh=prepareUsersSheet_(),vers=Number(u.versaoSessao||1)+1;sh.getRange(u.row,7).setValue(hash);sh.getRange(u.row,8).setValue(salt);sh.getRange(u.row,9).setValue("Ativo");sh.getRange(u.row,10).setValue("Não");sh.getRange(u.row,11).setValue(0);sh.getRange(u.row,12).clearContent();sh.getRange(u.row,16).setValue(new Date());sh.getRange(u.row,18).setValue(vers);prepareUserTokensSheet_().getRange(t.row,6).setValue(new Date());invalidarTokensUsuario_(u.idUsuario);audit741_(u,tipo==="ATIVACAO"?"USUARIO_ATIVADO":"SENHA_REDEFINIDA","USUARIO",u.idUsuario,"","SUCESSO","");return {ok:true,message:tipo==="ATIVACAO"?"Acesso ativado com sucesso.":"Senha redefinida com sucesso."};}

function getSystemCache_(){return CacheService.getScriptCache();}
function gerarTokenSessaoSistema_(){return Utilities.getUuid().replace(/-/g,"")+Utilities.getUuid().replace(/-/g,"");}
function buildSessionFromUser_(u){var p=u.idPrestador?getProviderById_(u.idPrestador):null;return {idUsuario:u.idUsuario,usuario:u.usuario,nome:u.nome||u.usuario,email:u.email,idPrestador:u.idPrestador||"",prestador:p?(p.nomeFantasia||p.nome):"",perfil:u.perfil,versaoSessao:Number(u.versaoSessao||1),loginEm:serializeValue_(new Date()),podeRegistrarPreventiva:p?p.podeRegistrarPreventiva:true,podeAtenderOC:p?p.podeAtenderOC:true};}
function salvarSessaoSistema_(d){var t=gerarTokenSessaoSistema_();getSystemCache_().put("system_session_"+t,JSON.stringify(d),CONFIG.SYSTEM_SESSION_SECONDS);return t;}
function getSystemSession_(t){if(!t)return null;var raw=getSystemCache_().get("system_session_"+t);if(!raw)return null;try{var s=JSON.parse(raw),u=getUserById_(s.idUsuario);if(!u||normalizarBusca_(u.status)!=="ativo"||Number(u.versaoSessao||1)!==Number(s.versaoSessao||0))return null;return s;}catch(e){return null;}}
function validarSessaoSistema_(t){var s=getSystemSession_(t);if(!s)throw new Error("Sessão inválida, expirada ou revogada. Faça login novamente.");return s;}
function isMasterSystemSession_(s){return !!s&&s.perfil==="MASTER";}
function isGestorSystemSession_(s){return !!s&&s.perfil==="GESTOR";}
function isWideScopeSession_(s){return !!s&&(s.perfil==="MASTER"||s.perfil==="GESTOR"||(!s.idPrestador&&s.perfil==="CONSULTA"));}
function sistemaPermitePrestador_(s,nome){if(!s)return false;if(s.perfil==="MASTER"||s.perfil==="GESTOR")return true;if(!s.idPrestador)return s.perfil==="CONSULTA";var p=getProviderById_(s.idPrestador),n=p?(p.nomeFantasia||p.nome):s.prestador;return normalizarBusca_(n)===normalizarBusca_(nome);}
function loginSystem_(b){var id=String(b.systemUsername||b.username||"").trim(),senha=String(b.systemPassword||b.password||"");if(!id||!senha)throw new Error("Informe usuário e senha.");var u=getUserByIdentifier_(id);if(!u){audit740_({nome:id},"LOGIN_FALHOU","AUTENTICACAO","","","FALHA","Usuário não encontrado.");throw new Error("Usuário ou senha inválidos.");}var st=normalizarBusca_(u.status);if(st==="inativo"){audit741_(u,"LOGIN_FALHOU","AUTENTICACAO",u.idUsuario,"","FALHA","Usuário inativo.");throw new Error("Usuário inativo.");}if(st==="convite pendente"){audit741_(u,"LOGIN_FALHOU","AUTENTICACAO",u.idUsuario,"","FALHA","Convite pendente.");throw new Error("Acesso ainda não ativado. Utilize o convite enviado por e-mail.");}var bl=u.bloqueadoAte instanceof Date?u.bloqueadoAte:new Date(u.bloqueadoAte||0);if(!isNaN(bl.getTime())&&bl.getTime()>Date.now()){audit741_(u,"LOGIN_FALHOU","AUTENTICACAO",u.idUsuario,"","BLOQUEADO","Tentativa durante bloqueio temporário.");throw new Error("Usuário temporariamente bloqueado. Tente novamente mais tarde.");}if(!u.senhaHash||!u.salt||!verifyPassword_(senha,u.salt,u.senhaHash)){var tent=Number(u.tentativasInvalidas||0)+1,sh=prepareUsersSheet_();sh.getRange(u.row,11).setValue(tent);if(tent>=CONFIG.LOGIN_MAX_ATTEMPTS){sh.getRange(u.row,12).setValue(new Date(Date.now()+CONFIG.LOGIN_LOCK_MINUTES*60000));sh.getRange(u.row,11).setValue(0);audit741_(u,"USUARIO_BLOQUEADO","AUTENTICACAO",u.idUsuario,"","BLOQUEADO","Tentativas inválidas.");throw new Error("Usuário bloqueado por "+CONFIG.LOGIN_LOCK_MINUTES+" minutos.");}audit741_(u,"LOGIN_FALHOU","AUTENTICACAO",u.idUsuario,"","FALHA","Senha inválida.");throw new Error("Usuário ou senha inválidos.");}var sh=prepareUsersSheet_();sh.getRange(u.row,11).setValue(0);sh.getRange(u.row,12).clearContent();sh.getRange(u.row,13).setValue(new Date());var s=buildSessionFromUser_(u),token=salvarSessaoSistema_(s);audit741_(s,"LOGIN_SUCESSO","AUTENTICACAO",u.idUsuario,"","SUCESSO","");return {ok:true,systemSessionToken:token,idUsuario:s.idUsuario,usuario:s.usuario,nome:s.nome,email:s.email,idPrestador:s.idPrestador,prestador:s.prestador,perfil:s.perfil,podeRegistrarPreventiva:s.podeRegistrarPreventiva,podeAtenderOC:s.podeAtenderOC,expiresIn:CONFIG.SYSTEM_SESSION_SECONDS};}
function logoutSystem_(b){var t=String(b.systemSessionToken||"");if(t)getSystemCache_().remove("system_session_"+t);return {ok:true};}

function authorizeOccurrenceChange_(s,oc){if(!s||s.perfil==="CONSULTA")throw new Error("Seu perfil não permite alterar ocorrências.");var row=findOccurrenceRow_(oc);if(!row)throw new Error("Ocorrência não encontrada.");var sh=prepareHistorySheet_(),id=sh.getRange(row,2).getValue(),a=findEquipmentById_(readEquipmentSheet_(),id);if(!a)throw new Error("Ativo não encontrado.");if(!sistemaPermitePrestador_(s,a.prestador))throw new Error("Acesso não autorizado para este prestador.");if(s.perfil==="PRESTADOR"){var p=getProviderById_(s.idPrestador);if(!p||!p.podeAtenderOC)throw new Error("Este prestador não está habilitado para atender OCs.");}return {row:row,ativo:a};}
function authorizePreventive_(s,a){if(!s||s.perfil==="CONSULTA")throw new Error("Seu perfil não permite registrar preventivas.");if(!sistemaPermitePrestador_(s,a.prestador))throw new Error("Acesso não autorizado para este prestador.");if(s.perfil==="PRESTADOR"){var p=getProviderById_(s.idPrestador);if(!p||!p.podeRegistrarPreventiva)throw new Error("Este prestador não está habilitado para registrar preventivas.");}}
function podeAdministrarUsuarios_(s){return !!s&&(s.perfil==="MASTER"||s.perfil==="GESTOR");}
function validarPerfilCriavel_(s,p){p=String(p||"").toUpperCase();if(["MASTER","GESTOR","PRESTADOR","CONSULTA"].indexOf(p)===-1)throw new Error("Perfil inválido.");if(s.perfil==="GESTOR"&&(p==="MASTER"||p==="GESTOR"))throw new Error("GESTOR pode criar apenas PRESTADOR ou CONSULTA.");return p;}
function listarUsuarios_(s){if(!podeAdministrarUsuarios_(s))throw new Error("Acesso não autorizado.");return readUsers_().map(function(u){var p=u.idPrestador?getProviderById_(u.idPrestador):null;return {idUsuario:u.idUsuario,nome:u.nome,usuario:u.usuario,email:u.email,idPrestador:u.idPrestador,prestador:p?(p.nomeFantasia||p.nome):"",perfil:u.perfil,status:u.status,ultimoLogin:serializeValue_(u.ultimoLogin)||"",bloqueadoAte:serializeValue_(u.bloqueadoAte)||""};}).filter(function(u){return s.perfil==="MASTER"||(u.perfil!=="MASTER"&&u.perfil!=="GESTOR");});}
function listarPrestadoresParaUsuario_(s){if(!s)throw new Error("Sessão inválida.");return readProviders_().filter(function(p){return p.ativo;}).map(function(p){return {idPrestador:p.idPrestador,nome:p.nome,nomeFantasia:p.nomeFantasia};});}
function criarUsuario_(b,s){if(!podeAdministrarUsuarios_(s))throw new Error("Acesso não autorizado.");var nome=String(b.userName||"").trim(),login=String(b.userLogin||"").trim(),email=String(b.userEmail||"").trim(),idp=String(b.userProviderId||"").trim(),perfil=validarPerfilCriavel_(s,b.userProfile);if(!nome||!login||!email)throw new Error("Informe nome, usuário/login e e-mail.");if(getUserByIdentifier_(login)||getUserByIdentifier_(email))throw new Error("Já existe usuário com esse login ou e-mail.");if(perfil==="PRESTADOR"&&!idp)throw new Error("Informe o prestador.");if(idp&&!getProviderById_(idp))throw new Error("Prestador inválido.");var id=nextUserId_();prepareUsersSheet_().appendRow([id,nome,login,email,idp,perfil,"","","Convite pendente","Sim",0,"","",new Date(),s.idUsuario,new Date(),"",1]);var u=getUserById_(id);enviarConviteUsuario_(u);audit741_(s,"USUARIO_CRIADO","USUARIO",id,"","SUCESSO","Convite enviado.");return {ok:true,idUsuario:id,message:"Usuário criado e convite enviado."};}
function atualizarStatusUsuario_(b,s){if(!podeAdministrarUsuarios_(s))throw new Error("Acesso não autorizado.");var u=getUserById_(b.userId);if(!u)throw new Error("Usuário não encontrado.");if(s.perfil==="GESTOR"&&(u.perfil==="MASTER"||u.perfil==="GESTOR"))throw new Error("GESTOR não pode alterar este usuário.");var novo=String(b.userStatus||"").trim();if(["Ativo","Bloqueado","Inativo"].indexOf(novo)===-1)throw new Error("Status inválido.");var sh=prepareUsersSheet_();sh.getRange(u.row,9).setValue(novo);sh.getRange(u.row,16).setValue(new Date());sh.getRange(u.row,18).setValue(Number(u.versaoSessao||1)+1);if(novo==="Inativo")sh.getRange(u.row,17).setValue(new Date());if(novo==="Ativo"){sh.getRange(u.row,11).setValue(0);sh.getRange(u.row,12).clearContent();}invalidarTokensUsuario_(u.idUsuario);audit741_(s,novo==="Inativo"?"USUARIO_DESATIVADO":"USUARIO_STATUS_ALTERADO","USUARIO",u.idUsuario,"","SUCESSO","Status alterado.",u.status,novo);return {ok:true};}
function reenviarConvite_(b,s){if(!podeAdministrarUsuarios_(s))throw new Error("Acesso não autorizado.");var u=getUserById_(b.userId);if(!u)throw new Error("Usuário não encontrado.");if(s.perfil==="GESTOR"&&(u.perfil==="MASTER"||u.perfil==="GESTOR"))throw new Error("GESTOR não pode alterar este usuário.");if(normalizarBusca_(u.status)==="inativo")throw new Error("Usuário inativo.");enviarConviteUsuario_(u);audit741_(s,"CONVITE_REENVIADO","USUARIO",u.idUsuario,"","SUCESSO","Convite de ativação reenviado.");return {ok:true,message:"Convite enviado."};}

function filtrarBuscaSistema_(r,s){if(isWideScopeSession_(s))return r;return (r||[]).filter(function(i){return sistemaPermitePrestador_(s,i.prestador);});}
function resumoPendencias_(it){var x={abertas:0,emAtendimento:0,aguardandoPeca:0,total:(it||[]).length};(it||[]).forEach(function(i){if(i.status==="Aberta")x.abertas++;if(i.status==="Em atendimento")x.emAtendimento++;if(i.status==="Aguardando peça")x.aguardandoPeca++;});return x;}
function filtrarPendenciasSistema_(p,s,f){f=f||{};var fp=normalizarBusca_(f.prestador||""),fs=normalizarBusca_(f.status||""),fc=normalizarBusca_(f.categoria||""),fv=normalizarBusca_(f.pavimento||""),fl=normalizarBusca_(f.localizacao||"");if(!isWideScopeSession_(s))fp=normalizarBusca_(s.prestador);var it=(p.occurrences||[]).filter(function(i){if(!sistemaPermitePrestador_(s,i.prestador||""))return false;if(fp&&normalizarBusca_(i.prestador)!==fp)return false;if(fs&&normalizarBusca_(i.status)!==fs)return false;if(fc&&normalizarBusca_(i.categoriaOcorrencia)!==fc)return false;if(fv&&normalizarBusca_(i.pavimento)!==fv)return false;if(fl&&normalizarBusca_(i.localizacao)!==fl)return false;return true;});return {summary:resumoPendencias_(it),occurrences:it.slice(0,CONFIG.PENDING_LIMIT)};}
function getPendingFiltersForSystem_(s){var b=filtrarPendenciasSistema_(getPendingOccurrences_(),s,{}).occurrences;function u(c){var m={};b.forEach(function(i){var v=String(i[c]||"").trim();if(v)m[v]=1;});return Object.keys(m).sort(function(a,b){return a.localeCompare(b,"pt-BR");});}return {prestadores:isWideScopeSession_(s)?u("prestador"):[s.prestador],status:CONFIG.ACTIVE_STATUS.slice(),categorias:u("categoriaOcorrencia"),pavimentos:u("pavimento"),localizacoes:u("localizacao")};}
function documentoPermitidoSistema_(d,s,mapa){if(isWideScopeSession_(s))return true;var a=normalizarBusca_(s.prestador);if(normalizarBusca_(d.prestador)===a)return true;var v=d.ativosVinculados||[];if(v.some(function(id){return normalizarBusca_(mapa[normId_(id)]||"")===a;}))return true;return !String(d.prestador||"").trim()&&!v.length&&!String(d.idAtivo||"").trim();}
function filtrarDocumentosSistema_(docs,s){if(isWideScopeSession_(s))return docs;var m={};readEquipmentSheet_().forEach(function(a){m[normId_(a.id)]=a.prestador||"";});return (docs||[]).filter(function(d){return documentoPermitidoSistema_(d,s,m);});}
function getTechnicalDocumentFiltersForSystem_(s){var d=filtrarDocumentosSistema_(buscarDocumentosTecnicos_("","","",""),s);function u(c){var m={};d.forEach(function(x){var v=String(x[c]||"").trim();if(v)m[v]=1;});return Object.keys(m).sort(function(a,b){return a.localeCompare(b,"pt-BR");});}return {tipos:u("tipoDocumento"),disciplinas:u("disciplina"),pavimentos:u("pavimento")};}
function getOccurrenceReportFiltersForSystem_(s){var f=getOccurrenceReportFilters_();if(!isWideScopeSession_(s))f.prestadores=[s.prestador];return f;}

/* Adaptadores de preventiva para sessão única */
function getPreventiveSession_(t){return getSystemSession_(t);}
function validarSessaoPreventiva_(t){return validarSessaoSistema_(t);}
function isMasterSession_(s){return !!s&&s.perfil==="MASTER";}
function prestadorPermitido_(s,p){return sistemaPermitePrestador_(s,p);}
function getEffectivePreventiveRequirements_(s,p){var r=getProviderRules_(p);return {exigirAssinatura:isMasterSession_(s)?false:r.exigirAssinatura,fotoObrigatoria:r.fotoObrigatoria,observacaoObrigatoria:r.observacaoObrigatoria};}
function loginPreventive_(){throw new Error("A partir da versão 7.4.0 utilize o login único do QRManut.");}
function logoutPreventive_(b){return logoutSystem_(b);}

/* Migração idempotente */
function migrarPrestadores740_(){var sh=prepareProvidersSheet_(),ex={};readProviders_().forEach(function(p){ex[normalizarBusca_(p.nomeFantasia||p.nome)]=p.idPrestador;});var ag={};readPreventiveAccess_().forEach(function(x){var nome=String(x.prestador||"").trim();if(!nome)return;var k=normalizarBusca_(nome);if(!ag[k])ag[k]={nome:nome,ass:false,foto:false,obs:false,noc:false,eoc:[],rel:false,erel:[]};var a=ag[k];a.ass=a.ass||x.exigirAssinatura;a.foto=a.foto||x.fotoObrigatoria;a.obs=a.obs||x.observacaoObrigatoria;a.noc=a.noc||x.notificarOC;a.rel=a.rel||x.enviarRelatorio;coletarEmails_(x.emailOC).forEach(function(e){if(a.eoc.indexOf(e)<0)a.eoc.push(e);});coletarEmails_(x.emailRelatorio).forEach(function(e){if(a.erel.indexOf(e)<0)a.erel.push(e);});});Object.keys(ag).sort().forEach(function(k){if(ex[k])return;var a=ag[k],id=nextProviderId_();sh.appendRow([id,a.nome,a.nome,"Sim",a.ass?"Sim":"Não",a.foto?"Sim":"Não",a.obs?"Sim":"Não","Sim","Sim",a.noc?"Sim":"Não",a.eoc.join(","),a.rel?"Sim":"Não",a.erel.join(","),"Migrado automaticamente da versão anterior."]);ex[k]=id;});}
function migrarUsuarios740_(){var sh=prepareUsersSheet_(),ex={};readUsers_().forEach(function(u){if(u.usuario)ex[normalizarBusca_(u.usuario)]=1;});var leg=[];try{readSystemAccess_().forEach(function(x){leg.push(x);});}catch(e){}var vistos={};function add(x){var login=String(x.usuario||"").trim();if(!login||vistos[normalizarBusca_(login)]||ex[normalizarBusca_(login)])return;vistos[normalizarBusca_(login)]=1;var p=getProviderByName_(x.prestador),perfil=String(x.perfil||"PRESTADOR").toUpperCase();if(["MASTER","GESTOR","PRESTADOR","CONSULTA"].indexOf(perfil)<0)perfil="PRESTADOR";var email="";if(perfil==="MASTER"){var cfg=getProviderReportConfig_(x.prestador);email=cfg.emails.length?cfg.emails[0]:CONFIG.NOTIFICATION_EMAIL_CC;}sh.appendRow([nextUserId_(),x.nome||login,login,email,p?p.idPrestador:"",perfil,"","","Convite pendente","Sim",0,"","",new Date(),"MIGRACAO_7.4.0",new Date(),"",1]);}leg.forEach(add);readPreventiveAccess_().forEach(add);}
function ensureEquipmentProviderIdColumn740_(){var sh=getSpreadsheet_().getSheetByName(CONFIG.EQUIPMENT_SHEET);if(!sh)return;var h=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0],n=h.map(normKey_),idx=n.indexOf("id_prestador");if(idx<0){sh.getRange(1,sh.getLastColumn()+1).setValue("ID Prestador").setFontWeight("bold");idx=sh.getLastColumn()-1;}var pi=n.indexOf("prestador");if(pi<0||sh.getLastRow()<=1)return;var nomes=sh.getRange(2,pi+1,sh.getLastRow()-1,1).getDisplayValues();sh.getRange(2,idx+1,nomes.length,1).setValues(nomes.map(function(r){return [providerIdFromName_(r[0])];}));}
function configurarSeguranca740_(){getSecurityPepper_();prepareUsersSheet_();prepareProvidersSheet_();prepareUserTokensSheet_();prepareAuditSheet_();migrarPrestadores740_();migrarUsuarios740_();ensureEquipmentProviderIdColumn740_();var sh=prepareUsersSheet_();sh.getRange(2,6,1000,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(["MASTER","GESTOR","PRESTADOR","CONSULTA"],true).setAllowInvalid(false).build());sh.getRange(2,9,1000,1).setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(["Convite pendente","Ativo","Bloqueado","Inativo"],true).setAllowInvalid(false).build());var sp=prepareProvidersSheet_(),sn=SpreadsheetApp.newDataValidation().requireValueInList(["Sim","Não"],true).setAllowInvalid(false).build();[4,5,6,7,8,9,10,12].forEach(function(c){sp.getRange(2,c,1000,1).setDataValidation(sn);});sh.autoResizeColumns(1,18);sp.autoResizeColumns(1,14);}
function enviarConviteMasterInicial740(){var u=readUsers_().find(function(x){return x.perfil==="MASTER"&&normalizarBusca_(x.status)!=="inativo";});if(!u)throw new Error("Nenhum MASTER migrado.");if(!u.email){prepareUsersSheet_().getRange(u.row,4).setValue(CONFIG.NOTIFICATION_EMAIL_CC);u=getUserById_(u.idUsuario);}var link=enviarConviteUsuario_(u);Logger.log("LINK DE ATIVAÇÃO MASTER: "+link);return link;}
function finalizarMigracaoSeguranca740(){[CONFIG.PREVENTIVE_ACCESS_SHEET,CONFIG.SYSTEM_ACCESS_SHEET].forEach(function(nome){var sh=getSpreadsheet_().getSheetByName(nome);if(!sh||sh.getLastRow()<=1)return;var h=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0].map(normKey_),i=h.indexOf("senha");if(i>=0)sh.getRange(2,i+1,sh.getLastRow()-1,1).clearContent();});Logger.log("Senhas legadas removidas das abas antigas.");}

/* ============================================================
 * IDS
 * ============================================================ */

function gerarNumeroOcorrencia_() {

  var lock =
    LockService.getScriptLock();

  lock.waitLock(
    30000
  );

  try {

    var sh =
      prepareHistorySheet_();

    var maior = 0;

    if (
      sh.getLastRow() > 1
    ) {

      sh.getRange(
        2,
        1,
        sh.getLastRow() - 1,
        1
      )
      .getDisplayValues()
      .forEach(
        function(row) {

          var match =
            String(
              row[0] || ""
            )
            .match(
              /^OC-(\d+)$/i
            );

          if (match) {

            maior =
              Math.max(
                maior,
                Number(match[1])
              );
          }
        }
      );
    }

    return (
      "OC-" +
      Utilities.formatString(
        "%06d",
        maior + 1
      )
    );

  } finally {

    lock.releaseLock();
  }
}

function audit741_(u,acao,tipo,idRegistro,idAtivo,resultado,detalhes,anterior,novo){
  audit740_(u,acao,tipo,idRegistro,idAtivo,resultado,detalhes,anterior,novo);
}

function serializeAuditValue_(v){
  if(v instanceof Date && !isNaN(v))return serializeValue_(v);
  if(v===null || v===undefined)return "";
  if(typeof v==="object"){try{return JSON.stringify(v);}catch(e){}}
  return String(v);
}

function getAuditFilters_(){
  var values=prepareAuditSheet_().getDataRange().getDisplayValues();
  var actions={},results={},users={};
  for(var i=1;i<values.length;i++){
    var r=values[i];
    if(r[4])actions[r[4]]=true;
    if(r[10])results[r[10]]=true;
    if(r[1]||r[2]){
      var k=String(r[1]||"")+"|"+String(r[2]||"");
      users[k]={idUsuario:String(r[1]||""),nome:String(r[2]||"")};
    }
  }
  return {
    actions:Object.keys(actions).sort(),
    results:Object.keys(results).sort(),
    users:Object.keys(users).map(function(k){return users[k];}).sort(function(a,b){
      return String(a.nome||a.idUsuario).localeCompare(String(b.nome||b.idUsuario),"pt-BR");
    })
  };
}

function parseAuditDate_(valor,fim){
  var t=String(valor||"").trim();
  if(!t)return null;
  var m=t.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m)throw new Error("Data de auditoria inválida.");
  return fim
    ? new Date(Number(m[1]),Number(m[2])-1,Number(m[3]),23,59,59,999)
    : new Date(Number(m[1]),Number(m[2])-1,Number(m[3]),0,0,0,0);
}

function getAuditRecords_(f,sessao){
  if(!sessao || sessao.perfil!=="MASTER")throw new Error("Somente MASTER pode consultar a auditoria.");
  f=f||{};
  var ini=parseAuditDate_(f.dataInicial,false),fim=parseAuditDate_(f.dataFinal,true);
  var acao=normalizarBusca_(f.acao||""),res=normalizarBusca_(f.resultado||"");
  var usr=normalizarBusca_(f.usuario||""),q=normalizarBusca_(f.q||"");
  var values=prepareAuditSheet_().getDataRange().getValues(),out=[];

  for(var i=values.length-1;i>=1;i--){
    var r=values[i],d=r[0] instanceof Date?r[0]:new Date(r[0]);
    if(ini && (isNaN(d.getTime())||d.getTime()<ini.getTime()))continue;
    if(fim && (isNaN(d.getTime())||d.getTime()>fim.getTime()))continue;
    if(acao && normalizarBusca_(r[4])!==acao)continue;
    if(res && normalizarBusca_(r[10])!==res)continue;
    var ut=[r[1],r[2]].map(normalizarBusca_).join(" ");
    if(usr && ut.indexOf(usr)===-1)continue;
    var bt=[r[1],r[2],r[3],r[4],r[5],r[6],r[7],r[8],r[9],r[10],r[11]].map(normalizarBusca_).join(" ");
    if(q && bt.indexOf(q)===-1)continue;

    out.push({
      dataHora:serializeValue_(d)||"",
      idUsuario:String(r[1]||""),
      nomeUsuario:String(r[2]||""),
      perfil:String(r[3]||""),
      acao:String(r[4]||""),
      tipoRegistro:String(r[5]||""),
      idRegistro:String(r[6]||""),
      idAtivo:String(r[7]||""),
      valorAnterior:serializeAuditValue_(r[8]),
      valorNovo:serializeAuditValue_(r[9]),
      resultado:String(r[10]||""),
      detalhes:String(r[11]||"")
    });
    if(out.length>=CONFIG.AUDIT_QUERY_LIMIT)break;
  }
  return {total:out.length,limit:CONFIG.AUDIT_QUERY_LIMIT,records:out};
}



