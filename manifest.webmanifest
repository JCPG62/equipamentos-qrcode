  };
}



/* ============================================================
 * VÍNCULOS DOCUMENTO x ATIVO – 7.3.1
 *
 * Permite que um único PDF (ex.: um manual de modelo) seja
 * relacionado a vários equipamentos sem duplicar o arquivo.
 * ============================================================ */

function getTechnicalDocumentLinksSheet_() {

  var ss = getSpreadsheet_();
  var sh = ss.getSheetByName(CONFIG.TECHNICAL_DOCUMENT_LINKS_SHEET);

  if (!sh) {
    sh = ss.insertSheet(CONFIG.TECHNICAL_DOCUMENT_LINKS_SHEET);
  }

  return sh;
}


function prepareTechnicalDocumentLinksSheet_() {

  var sh = getTechnicalDocumentLinksSheet_();

  var headers = [
    "ID Documento",
    "ID Ativo",
    "Observações do Vínculo",
    "Ativo"
  ];

  sh.getRange(1,1,1,headers.length)
    .setValues([headers])
    .setFontWeight("bold");

  sh.setFrozenRows(1);

  return sh;
}


function readTechnicalDocumentLinks_() {

  var values = prepareTechnicalDocumentLinksSheet_()
    .getDataRange()
    .getDisplayValues();

  if (values.length <= 1) return [];

  return values.slice(1)
    .filter(function(r) {
      return String(r[0] || "").trim() || String(r[1] || "").trim();
    })
    .map(function(r) {
      return {
        idDocumento: String(r[0] || "").trim().toUpperCase(),
        idAtivo: normId_(r[1]),
        observacoes: String(r[2] || "").trim(),
        ativo: normalizarBusca_(r[3] || "Sim") !== "nao"
      };
    });
}


function splitAssetIds_(texto) {

  var mapa = {};

  String(texto || "")
    .split(/[;,|\n]+/)
    .forEach(function(v) {
      var id = normId_(v);
      if (id) mapa[id] = true;
    });

  return Object.keys(mapa);
}


function getDocumentAssetMap_() {
  var cached=cacheGetJson_("v743_documentos_vinculos");
  if(cached)return cached;


  var mapa = {};

  readTechnicalDocumentLinks_().forEach(function(v) {
    if (!v.ativo || !v.idDocumento || !v.idAtivo) return;
    if (!mapa[v.idDocumento]) mapa[v.idDocumento] = {};
    mapa[v.idDocumento][v.idAtivo] = true;
  });

  /* Compatibilidade com a coluna antiga "ID do Ativo". */
  readTechnicalDocuments_().forEach(function(d) {
    var docId = String(d.id_documento || "").trim().toUpperCase();
    if (!docId) return;
    splitAssetIds_(d.id_do_ativo).forEach(function(assetId) {
      if (!mapa[docId]) mapa[docId] = {};
      mapa[docId][assetId] = true;
    });
  });

  cachePutJson_("v743_documentos_vinculos",mapa);
  return mapa;

}


function documentToPayload_(d, linkedAssets) {

  return {
    idDocumento: d.id_documento || "",
    titulo: d.titulo || "",
    tipoDocumento: d.tipo_de_documento || "",
    disciplina: d.disciplina || "",
    pavimento: d.pavimento || "",
    ambiente: d.ambiente || "",
    prestador: d.prestador || "",
    assunto: d.assunto || "",
    idAtivo: d.id_do_ativo || "",
    ativosVinculados: linkedAssets || [],
    revisao: d.revisao || "",
    dataDocumento: d.data_documento || "",
    linkPdf: d.link_pdf || "",
    status: d.status || "Ativo",
    observacoes: d.observacoes || ""
  };
}


function getTechnicalDocumentsByAsset_(equipmentId) {

  var target = normId_(equipmentId);
  if (!target) return [];

  var docs = readTechnicalDocuments_();
  var mapaVinculos = getDocumentAssetMap_();
  var resultados = [];

  docs.forEach(function(d) {

    var status = normalizarBusca_(d.status);
    if (status === "obsoleto" || status === "inativo") return;

    var docId = String(d.id_documento || "").trim().toUpperCase();
    var ativos = Object.keys(mapaVinculos[docId] || {});

    if (ativos.indexOf(target) === -1) return;

    resultados.push(documentToPayload_(d, ativos));
  });

  resultados.sort(function(a,b) {
    var aManual = normalizarBusca_(a.tipoDocumento) === "manual" ? 0 : 1;
    var bManual = normalizarBusca_(b.tipoDocumento) === "manual" ? 0 : 1;
    if (aManual !== bManual) return aManual - bManual;
    return String(a.titulo).localeCompare(String(b.titulo), "pt-BR");
  });

  return resultados;
}


function vincularDocumentoAtivo731(idDocumento, idAtivo, observacoes) {

  var docId = String(idDocumento || "").trim().toUpperCase();
  var assetId = normId_(idAtivo);

  if (!docId || !assetId) {
    throw new Error("Informe ID Documento e ID Ativo.");
  }

  var docs = readTechnicalDocuments_();
  var existeDoc = docs.some(function(d) {
    return String(d.id_documento || "").trim().toUpperCase() === docId;
  });

  if (!existeDoc) throw new Error("Documento não encontrado: " + docId);

  if (!findEquipmentById_(readEquipmentSheet_(), assetId)) {
    throw new Error("Ativo não encontrado: " + assetId);
  }

  var links = readTechnicalDocumentLinks_();
  var existe = links.some(function(v) {
    return v.ativo && v.idDocumento === docId && v.idAtivo === assetId;
  });

  if (existe) {
    return {ok:true, existente:true, idDocumento:docId, idAtivo:assetId};
  }

  prepareTechnicalDocumentLinksSheet_().appendRow([
    docId,
    assetId,
    String(observacoes || ""),
    "Sim"
  ]);

  invalidateDocumentCaches_();
  return {ok:true, existente:false, idDocumento:docId, idAtivo:assetId};
}


function migrarVinculosLegadosDocumentos731() {

  var sh = prepareTechnicalDocumentLinksSheet_();
  var links = readTechnicalDocumentLinks_();
  var existentes = {};
  var adicionados = 0;

  links.forEach(function(v) {
    if (v.idDocumento && v.idAtivo) {
      existentes[v.idDocumento + "|" + v.idAtivo] = true;
    }
  });

  readTechnicalDocuments_().forEach(function(d) {
    var docId = String(d.id_documento || "").trim().toUpperCase();
    if (!docId) return;

    splitAssetIds_(d.id_do_ativo).forEach(function(assetId) {
      var chave = docId + "|" + assetId;
      if (existentes[chave]) return;
      sh.appendRow([docId, assetId, "Migrado da coluna ID do Ativo", "Sim"]);
      existentes[chave] = true;
      adicionados++;
    });
  });

  Logger.log("Vínculos legados migrados: " + adicionados);
  return adicionados;
}


function configurarVinculosDocumentos731() {

  var sh = prepareTechnicalDocumentLinksSheet_();

  var regraSN = SpreadsheetApp.newDataValidation()
    .requireValueInList(["Sim","Não"], true)
    .setAllowInvalid(false)
    .build();

  sh.getRange(2,4,1000,1).setDataValidation(regraSN);
  sh.autoResizeColumns(1,4);

  migrarVinculosLegadosDocumentos731();

  Logger.log("Documentos_Ativos configurado para QRManut 7.3.1.");
}


/* ============================================================
 * DOCUMENTOS TÉCNICOS – 7.3
 *
 * Os PDFs permanecem no Google Drive.
 * A planilha guarda somente classificação, metadados e link.
 * ============================================================ */

function getTechnicalDocumentsSheet_() {

  var ss = getSpreadsheet_();
  var sh = ss.getSheetByName(CONFIG.TECHNICAL_DOCUMENTS_SHEET);

  if (!sh) {
    sh = ss.insertSheet(CONFIG.TECHNICAL_DOCUMENTS_SHEET);
  }

  return sh;
}


function prepareTechnicalDocumentsSheet_() {

  var sh = getTechnicalDocumentsSheet_();

  var headers = [
    "ID Documento",
    "Título",
    "Tipo de Documento",
    "Disciplina",
    "Pavimento",
    "Ambiente",
    "Prestador",
    "Assunto",
    "ID do Ativo",
    "Revisão",
    "Data Documento",
    "Link PDF",
    "Status",
    "Observações",
    "ID Arquivo Drive",
    "Hash SHA-256"
  ];

  sh.getRange(1,1,1,headers.length)
    .setValues([headers])
    .setFontWeight("bold");

  sh.setFrozenRows(1);

  return sh;
}


function readTechnicalDocuments_() {

  var values = prepareTechnicalDocumentsSheet_()
    .getDataRange()
    .getValues();

  if (values.length <= 1) {
    return [];
  }

  var headers = values[0].map(normKey_);

  return values.slice(1)
    .filter(function(row) {
      return row.some(function(v) {
        return String(v || "").trim() !== "";
      });
    })
    .map(function(row) {

      var obj = {};

      headers.forEach(function(h,i) {
        obj[h] = serializeValue_(row[i]);
      });

      return obj;
    });
}


function nextTechnicalDocumentId_() {

  var sh = prepareTechnicalDocumentsSheet_();
  var maior = 0;

  if (sh.getLastRow() > 1) {

    sh.getRange(2,1,sh.getLastRow()-1,1)
      .getDisplayValues()
      .forEach(function(row) {

        var m = String(row[0] || "").match(/^DOC-(\d+)$/i);

        if (m) {
          maior = Math.max(maior, Number(m[1]));
        }
      });
  }

  return "DOC-" + Utilities.formatString("%04d", maior + 1);
}


function titleCaseDocumento_(texto) {

  var pequenas = {
    "de":true,
    "da":true,
    "do":true,
    "das":true,
    "dos":true,
    "e":true
  };

  return String(texto || "")
    .toLowerCase()
    .split(/\s+/)
    .filter(Boolean)
    .map(function(p, i) {
      if (i > 0 && pequenas[p]) return p;
      return p.charAt(0).toUpperCase() + p.slice(1);
    })
    .join(" ");
}


function classificarDocumentoPorNome_(nomeArquivo) {

  var original = String(nomeArquivo || "");
  var semExt = original.replace(/\.pdf$/i, "");
  var base = normalizarBusca_(semExt.replace(/[_-]+/g," "));

  var tipo = "Outros";
  var disciplina = "Outros";
  var pavimento = "";
  var ambiente = "";
  var prestador = "";
  var assunto = "";

  if (/\bmanual\b/.test(base)) tipo = "Manual";
  else if (/\bdiagrama\b|\besquema\b/.test(base)) tipo = "Diagrama";
  else if (/\bprocedimento\b|\bpop\b/.test(base)) tipo = "Procedimento";
  else if (/\blaudo\b/.test(base)) tipo = "Laudo";
  else if (/\bcertificado\b/.test(base)) tipo = "Certificado";
  else if (/\bficha tecnica\b/.test(base)) tipo = "Ficha Técnica";
  else if (/planta|quadro disjuntores|extintor|hidrante|evaporador|condensador|exaustor|ventilador|ar condicionado/.test(base)) tipo = "Planta / Mapa";

  if (/quadro disjuntores|eletric|disjuntor/.test(base)) {
    disciplina = "Elétrica";
    assunto = "Quadros de Disjuntores";
  }
  else if (/extintor|hidrante|incendio/.test(base)) {
    disciplina = "Segurança";
    assunto = "Extintores e Hidrantes";
  }
  else if (/evaporador/.test(base)) {
    disciplina = "Climatização";
    assunto = "Evaporadoras";
  }
  else if (/condensador/.test(base)) {
    disciplina = "Climatização";
    assunto = "Condensadoras";
  }
  else if (/exaustor/.test(base)) {
    disciplina = "Climatização";
    assunto = "Exaustores";
  }
  else if (/ventilador/.test(base)) {
    disciplina = "Climatização";
    assunto = "Ventiladores";
  }
  else if (/ar condicionado/.test(base)) {
    disciplina = "Climatização";
    assunto = "Ar-condicionado";
  }
  else if (/hidraulic/.test(base)) {
    disciplina = "Hidráulica";
  }
  else if (/civil|arquitet/.test(base)) {
    disciplina = "Civil / Arquitetura";
  }

  if (/\bjap\b/.test(base)) prestador = "JAP";
  else if (/\bfepon\b/.test(base)) prestador = "FEPON";

  if (/\b1\s*piso\b|\b1o piso\b|\b1º piso\b/.test(base)) pavimento = "1º PISO";
  else if (/\b2\s*piso\b|\b2o piso\b|\b2º piso\b/.test(base)) pavimento = "2º PISO";
  else if (/\b3\s*piso\b|\b3o piso\b|\b3º piso\b/.test(base)) pavimento = "3º PISO";
  else if (/\bpatio\b|\bpátio\b|\barea externa\b/.test(base)) pavimento = "ÁREA EXTERNA";

  var titulo = semExt
    .replace(/[_-]+/g," ")
    .replace(/\s+/g," ")
    .trim();

  titulo = titleCaseDocumento_(titulo)
    .replace(/\bJap\b/g,"JAP")
    .replace(/\bFepon\b/g,"FEPON");

  return {
    titulo: titulo,
    tipoDocumento: tipo,
    disciplina: disciplina,
    pavimento: pavimento,
    ambiente: ambiente,
    prestador: prestador,
    assunto: assunto
  };
}


function getOrCreateTechnicalDocumentsFolder_() {

  var folders = DriveApp.getFoldersByName(CONFIG.TECHNICAL_DOCUMENTS_FOLDER_NAME);

  if (folders.hasNext()) {
    return folders.next();
  }

  return DriveApp.createFolder(CONFIG.TECHNICAL_DOCUMENTS_FOLDER_NAME);
}


function criarPastaDocumentosTecnicos73() {

  var folder = getOrCreateTechnicalDocumentsFolder_();

  Logger.log("Pasta Documentos Técnicos: " + folder.getUrl());
  Logger.log("Coloque os PDFs nesta pasta e depois execute sincronizarDocumentosTecnicos73().");

  return folder.getUrl();
}



/* ============================================================
 * UPLOAD DE DOCUMENTOS – 7.4.4
 * ============================================================ */

function podeEnviarDocumento_(s){
  return !!s && (s.perfil==="MASTER" || s.perfil==="GESTOR");
}

function documentSha256Hex_(bytes){
  return Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    bytes
  ).map(function(b){
    var v=b<0?b+256:b;
    return ("0"+v.toString(16)).slice(-2);
  }).join("");
}

function getDocumentUploadMetadata_(s){
  if(!podeEnviarDocumento_(s))throw new Error("Seu perfil não permite enviar documentos.");

  return{
    tipos:["Planta / Mapa","Manual","Diagrama","Procedimento","Laudo","Certificado","Ficha Técnica","Outros"],
    disciplinas:["Elétrica","Hidráulica","Climatização","Refrigeração","Segurança","Civil / Arquitetura","Equipamento","Outros"],
    pavimentos:["ÁREA EXTERNA","1º PISO","2º PISO","3º PISO"],
    prestadores:readProviders_().filter(function(p){return p.ativo;}).map(function(p){
      return{idPrestador:p.idPrestador,nome:p.nomeFantasia||p.nome};
    }).sort(function(a,b){return a.nome.localeCompare(b.nome,"pt-BR");}),
    maxBytes:CONFIG.MAX_DOCUMENT_BYTES
  };
}

function localizarDocumentoPorHash_(hash){
  var alvo=String(hash||"").trim().toLowerCase();
  if(!alvo)return null;
  var docs=readTechnicalDocuments_();
  for(var i=0;i<docs.length;i++){
    if(String(docs[i].hash_sha_256||"").trim().toLowerCase()===alvo)return docs[i];
  }
  return null;
}

function uploadTechnicalDocument_(b,s){
  if(!podeEnviarDocumento_(s))throw new Error("Somente MASTER ou GESTOR pode enviar documentos.");

  var titulo=String(b.documentTitle||"").trim();
  var tipo=String(b.documentType||"").trim();
  var disciplina=String(b.documentDiscipline||"").trim();
  var pavimento=String(b.documentFloor||"").trim();
  var ambiente=String(b.documentEnvironment||"").trim();
  var prestador=String(b.documentProvider||"").trim();
  var assunto=String(b.documentSubject||"").trim();
  var revisao=String(b.documentRevision||"").trim();
  var observacoes=String(b.documentNotes||"").trim();
  var idAtivo=normId_(b.documentAssetId||"");
  var nomeArquivo=String(b.documentFileName||"").trim();
  var base64=String(b.documentBase64||"").trim();

  if(!titulo)throw new Error("Informe o título do documento.");
  if(!tipo)throw new Error("Informe o tipo do documento.");
  if(!base64)throw new Error("Selecione um arquivo PDF.");

  var match=base64.match(/^data:application\/pdf;base64,(.+)$/i);
  if(!match)throw new Error("Arquivo inválido. Nesta versão somente PDF é permitido.");

  var bytes=Utilities.base64Decode(match[1]);
  if(bytes.length>CONFIG.MAX_DOCUMENT_BYTES){
    throw new Error("O PDF ultrapassa o limite de "+Math.round(CONFIG.MAX_DOCUMENT_BYTES/1024/1024)+" MB.");
  }

  if(idAtivo && !findEquipmentById_(readEquipmentSheet_(),idAtivo)){
    throw new Error("Ativo não encontrado: "+idAtivo);
  }

  var hash=documentSha256Hex_(bytes);
  var dup=localizarDocumentoPorHash_(hash);
  if(dup)throw new Error("Este PDF já está cadastrado como "+String(dup.id_documento||"documento existente")+".");

  var nome=nomeArquivo.replace(/[^\w.\-() ]+/g,"_").trim();
  if(!nome)nome="documento_"+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyyyMMdd_HHmmss")+".pdf";
  if(!/\.pdf$/i.test(nome))nome+=".pdf";

  var file=getOrCreateTechnicalDocumentsFolder_().createFile(
    Utilities.newBlob(bytes,MimeType.PDF,nome)
  );

  try{
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);
  }catch(e){}

  var docId=nextTechnicalDocumentId_();
  prepareTechnicalDocumentsSheet_().appendRow([
    docId,titulo,tipo,disciplina,pavimento,ambiente,prestador,assunto,
    idAtivo,revisao,new Date(),file.getUrl(),"Ativo",observacoes,file.getId(),hash
  ]);

  if(idAtivo){
    vincularDocumentoAtivo731(
      docId,
      idAtivo,
      "Vínculo criado no upload 7.4.4 por "+(s.nome||s.usuario||s.idUsuario)
    );
  }

  SpreadsheetApp.flush();
  invalidateDocumentCaches_();

  audit741_(
    s,
    "DOCUMENTO_ENVIADO",
    "DOCUMENTO_TECNICO",
    docId,
    idAtivo,
    "SUCESSO",
    "PDF enviado pelo QRManut: "+nome,
    "",
    {titulo:titulo,tipo:tipo,disciplina:disciplina,pavimento:pavimento,prestador:prestador,revisao:revisao,idAtivo:idAtivo,arquivoDrive:file.getId()}
  );

  return{
    ok:true,
    idDocumento:docId,
    titulo:titulo,
    linkPdf:file.getUrl(),
    idAtivo:idAtivo,
    vinculado:!!idAtivo,
    message:"Documento enviado com sucesso."
  };
}


function sincronizarDocumentosTecnicos73() {

  var folder = getOrCreateTechnicalDocumentsFolder_();
  var sh = prepareTechnicalDocumentsSheet_();
  var existentes = {};

  if (sh.getLastRow() > 1) {

    sh.getRange(2,15,sh.getLastRow()-1,1)
      .getDisplayValues()
      .forEach(function(row) {
        var id = String(row[0] || "").trim();
        if (id) existentes[id] = true;
      });
  }

  var files = folder.getFiles();
  var adicionados = 0;
  var ignorados = 0;

  while (files.hasNext()) {

    var file = files.next();

    if (file.getMimeType() !== MimeType.PDF) {
      ignorados++;
      continue;
    }

    var driveId = file.getId();

    if (existentes[driveId]) {
      ignorados++;
      continue;
    }

    var c = classificarDocumentoPorNome_(file.getName());

    sh.appendRow([
      nextTechnicalDocumentId_(),
      c.titulo,
      c.tipoDocumento,
      c.disciplina,
      c.pavimento,
      c.ambiente,
      c.prestador,
      c.assunto,
      "",
      "",
      file.getDateCreated(),
      file.getUrl(),
      "Ativo",
      "Classificação inicial gerada automaticamente pelo nome do arquivo. Revisar se necessário.",
      driveId
    ]);

    existentes[driveId] = true;
    adicionados++;
  }

  SpreadsheetApp.flush();
  invalidateDocumentCaches_();

  Logger.log("=================================");
  Logger.log("DOCUMENTOS ADICIONADOS: " + adicionados);
  Logger.log("DOCUMENTOS IGNORADOS: " + ignorados);
  Logger.log("PASTA: " + folder.getUrl());
  Logger.log("=================================");

  return {
    adicionados: adicionados,
    ignorados: ignorados,
    pasta: folder.getUrl()
  };
}


function buscarDocumentosTecnicos_(q, tipo, disciplina, pavimento) {

  var termo = normalizarBusca_(q || "");
  var tipoFiltro = normalizarBusca_(tipo || "");
  var disciplinaFiltro = normalizarBusca_(disciplina || "");
  var pavimentoFiltro = normalizarBusca_(pavimento || "");

  var docs = readTechnicalDocuments_();
  var mapaVinculos = getDocumentAssetMap_();
  var resultados = [];

  docs.forEach(function(d) {

    if (normalizarBusca_(d.status) === "obsoleto" || normalizarBusca_(d.status) === "inativo") {
      return;
    }

    if (tipoFiltro && normalizarBusca_(d.tipo_de_documento) !== tipoFiltro) return;
    if (disciplinaFiltro && normalizarBusca_(d.disciplina) !== disciplinaFiltro) return;
    if (pavimentoFiltro && normalizarBusca_(d.pavimento) !== pavimentoFiltro) return;

    var docId = String(d.id_documento || "").trim().toUpperCase();
    var ativos = Object.keys(mapaVinculos[docId] || {});

    var texto = [
      d.id_documento,
      d.titulo,
      d.tipo_de_documento,
      d.disciplina,
      d.pavimento,
      d.ambiente,
      d.prestador,
      d.assunto,
      d.id_do_ativo,
      ativos.join(" "),
      d.revisao,
      d.observacoes
    ].map(normalizarBusca_).join(" ");

    if (termo && texto.indexOf(termo) === -1) return;

    resultados.push(documentToPayload_(d, ativos));
  });

  resultados.sort(function(a,b) {
    return String(a.titulo).localeCompare(String(b.titulo), "pt-BR");
  });

  return resultados.slice(0,200);
}

function getTechnicalDocumentFilters_() {

  var docs = readTechnicalDocuments_().filter(function(d) {
    return normalizarBusca_(d.status) !== "obsoleto" && normalizarBusca_(d.status) !== "inativo";
  });

  function unicos(campo) {
    var mapa = {};
    docs.forEach(function(d) {
      var v = String(d[campo] || "").trim();
      if (v) mapa[v] = true;
    });
    return Object.keys(mapa).sort(function(a,b) {
      return a.localeCompare(b,"pt-BR");
    });
  }

  return {
    tipos: unicos("tipo_de_documento"),
    disciplinas: unicos("disciplina"),
    pavimentos: unicos("pavimento")
  };
}


function configurarDocumentosTecnicos73() {

  var sh = prepareTechnicalDocumentsSheet_();

  var tipos = [
    "Planta / Mapa",
    "Manual",
    "Diagrama",
    "Procedimento",
    "Laudo",
    "Certificado",
    "Ficha Técnica",
    "Outros"
  ];

  var disciplinas = [
    "Elétrica",
    "Hidráulica",
    "Climatização",
    "Refrigeração",
    "Segurança",
    "Civil / Arquitetura",
    "Equipamento",
    "Outros"
  ];

  var pavimentos = [
    "ÁREA EXTERNA",
    "1º PISO",
    "2º PISO",
    "3º PISO"
  ];

  var regraTipo = SpreadsheetApp.newDataValidation()
    .requireValueInList(tipos,true)
    .setAllowInvalid(true)
    .build();

  var regraDisciplina = SpreadsheetApp.newDataValidation()
    .requireValueInList(disciplinas,true)
    .setAllowInvalid(true)
    .build();

  var regraPavimento = SpreadsheetApp.newDataValidation()
    .requireValueInList(pavimentos,true)
    .setAllowInvalid(true)
    .build();

  var regraStatus = SpreadsheetApp.newDataValidation()
    .requireValueInList(["Ativo","Obsoleto"],true)
    .setAllowInvalid(false)
    .build();

  sh.getRange(2,3,500,1).setDataValidation(regraTipo);
  sh.getRange(2,4,500,1).setDataValidation(regraDisciplina);
  sh.getRange(2,5,500,1).setDataValidation(regraPavimento);
  sh.getRange(2,13,500,1).setDataValidation(regraStatus);
  sh.getRange(2,11,500,1).setNumberFormat("dd/MM/yyyy");

  sh.autoResizeColumns(1,16);

  criarPastaDocumentosTecnicos73();

  Logger.log("Documentos_Tecnicos configurado para QRManut 7.3.");
}


function testeClassificacaoDocumentos73() {

  [
    "QUADRO_DISJUNTORES_2 PISO.pdf",
    "JAP_EVAPORADORAS_2 PISO.pdf",
    "EXTINTOR_HIDRANTE_PATIO_PISO.pdf",
    "FEPON_CONDENSADORAS_3 PISO.pdf"
  ].forEach(function(nome) {
    Logger.log(nome + " => " + JSON.stringify(classificarDocumentoPorNome_(nome)));
  });
}



/* ============================================================
 * RELATÓRIO DE OCs CONCLUÍDAS – 7.3.5
 *
 * O período é calculado pela Data de conclusão da OC.
 * ============================================================ */

function parseDataRelatorioOC_(texto,fimDoDia) {

  var valor =
    String(texto || "")
      .trim();

  var m =
    valor.match(
      /^(\d{4})-(\d{2})-(\d{2})$/
    );

  if (!m) {

    throw new Error(
      "Data inválida. Utilize o formato YYYY-MM-DD."
    );
  }

  var ano =
    Number(m[1]);

  var mes =
    Number(m[2]);

  var dia =
    Number(m[3]);

  var data =
    fimDoDia
      ? new Date(
          ano,
          mes - 1,
          dia,
          23,
          59,
          59,
          999
        )
      : new Date(
          ano,
          mes - 1,
          dia,
          0,
          0,
          0,
          0
        );

  if (
    data.getFullYear() !== ano ||
    data.getMonth() !== mes - 1 ||
    data.getDate() !== dia
  ) {

    throw new Error(
      "Data inválida."
    );
  }

  return data;
}


function formatarDataRelatorioOC_(valor) {

  if (!valor) {

    return "-";
  }

  var data =
    valor instanceof Date
      ? valor
      : new Date(valor);

  if (
    isNaN(
      data.getTime()
    )
  ) {

    return String(valor);
  }

  return Utilities.formatDate(
    data,
    Session.getScriptTimeZone(),
    "dd/MM/yyyy"
  );
}


function formatarHorasRelatorioOC_(horas) {

  if (
    horas === null ||
    horas === undefined ||
    horas === ""
  ) {

    return "-";
  }

  var valor =
    Number(horas);

  if (
    !isFinite(valor) ||
    valor < 0
  ) {

    return "-";
  }

  if (
    valor < 24
  ) {

    return (
      valor.toFixed(1)
        .replace(".",",") +
      " h"
    );
  }

  var dias =
    valor / 24;

  return (
    dias.toFixed(1)
      .replace(".",",") +
    " dia(s)"
  );
}


function getOccurrenceReportFilters_() {

  var ativos =
    readEquipmentSheet_();

  function unicos_(valores) {

    var mapa = {};

    valores.forEach(
      function(v) {

        var texto =
          String(v || "")
            .trim();

        if (texto) {

          mapa[texto] = true;
        }
      }
    );

    return Object.keys(mapa)
      .sort(
        function(a,b) {

          return a.localeCompare(
            b,
            "pt-BR"
          );
        }
      );
  }

  return {

    prestadores:
      unicos_(
        ativos.map(
          function(a) {
            return a.prestador;
          }
        )
      ),

    categorias:
      readOccurrenceCategories_(false).map(function(x){return x.nomePt;}),

    componentes:
      (function(){var m={};readOccurrenceComponents_(false).forEach(function(x){m[x.nomePt]=1;});return Object.keys(m).sort(function(a,b){return a.localeCompare(b,"pt-BR");});})(),

    pavimentos:
      unicos_(
        ativos.map(
          function(a) {
            return a.pavimento;
          }
        )
      ),

    localizacoes:
      unicos_(
        ativos.map(
          function(a) {
            return a.localizacao;
          }
        )
      )

  };
}


function getOccurrenceReport_(filtros) {

  filtros =
    filtros || {};

  var dataInicial =
    parseDataRelatorioOC_(
      filtros.dataInicial,
      false
    );

  var dataFinal =
    parseDataRelatorioOC_(
      filtros.dataFinal,
      true
    );

  if (
    dataFinal.getTime() <
    dataInicial.getTime()
  ) {

    throw new Error(
      "A data final não pode ser anterior à data inicial."
    );
  }

  var filtroPrestador =
    normalizarBusca_(
      filtros.prestador || ""
    );

  var filtroCategoria =
    normalizarBusca_(
      filtros.categoria || ""
    );

  var filtroComponente =
    normalizarBusca_(
      filtros.componente || ""
    );

  var filtroPavimento =
    normalizarBusca_(
      filtros.pavimento || ""
    );

  var filtroLocalizacao =
    normalizarBusca_(
      filtros.localizacao || ""
    );

  var ativos =
    readEquipmentSheet_();

  var mapaAtivos = {};

  ativos.forEach(
    function(a) {

      mapaAtivos[
        normId_(
          a.id
        )
      ] = a;
    }
  );

  var values =
    prepareHistorySheet_()
      .getDataRange()
      .getValues();

  var itens = [];

  var somaHoras = 0;
  var qtdTempos = 0;

  var categoriasMap = {};
  var prestadoresMap = {};

  for (
    var i = 1;
    i < values.length;
    i++
  ) {

    var r =
      values[i];

    var status =
      String(
        r[8] || ""
      )
      .trim();

    if (
      normalizarBusca_(
        status
      ) !== "concluida"
    ) {

      continue;
    }

    var dataConclusao =
      r[11] instanceof Date
        ? r[11]
        : new Date(
            r[11]
          );

    if (
      isNaN(
        dataConclusao.getTime()
      )
    ) {

      continue;
    }

    if (
      dataConclusao.getTime() <
        dataInicial.getTime() ||
      dataConclusao.getTime() >
        dataFinal.getTime()
    ) {

      continue;
    }

    var ativo =
      mapaAtivos[
        normId_(
          r[1]
        )
      ] || {};

    var prestador =
      String(
        ativo.prestador || ""
      );

    var categoria =
      String(
        r[14] || ""
      );

    var componente =
      String(
        r[15] || ""
      );

    var pavimento =
      String(
        ativo.pavimento || ""
      );

    var localizacao =
      String(
        ativo.localizacao || ""
      );

    if (
      filtroPrestador &&
      normalizarBusca_(
        prestador
      ) !== filtroPrestador
    ) {

      continue;
    }

    if (
      filtroCategoria &&
      normalizarBusca_(
        categoria
      ) !== filtroCategoria
    ) {

      continue;
    }

    if (
      filtroComponente &&
      normalizarBusca_(
        componente
      ) !== filtroComponente
    ) {

      continue;
    }

    if (
      filtroPavimento &&
      normalizarBusca_(
        pavimento
      ) !== filtroPavimento
    ) {

      continue;
    }

    if (
      filtroLocalizacao &&
      normalizarBusca_(
        localizacao
      ) !== filtroLocalizacao
    ) {

      continue;
    }

    var dataAbertura =
      r[3] instanceof Date
        ? r[3]
        : new Date(
            r[3]
          );

    var tempoHoras = null;

    if (
      !isNaN(
        dataAbertura.getTime()
      ) &&
      dataConclusao.getTime() >=
        dataAbertura.getTime()
    ) {

      tempoHoras =
        (
          dataConclusao.getTime() -
          dataAbertura.getTime()
        ) /
        3600000;

      somaHoras +=
        tempoHoras;

      qtdTempos++;
    }

    var categoriaResumo =
      categoria ||
      "Não informada";

    categoriasMap[
      categoriaResumo
    ] =
      (
        categoriasMap[
          categoriaResumo
        ] || 0
      ) + 1;

    var prestadorResumo =
      prestador ||
      "Não informado";

    prestadoresMap[
      prestadorResumo
    ] =
      (
        prestadoresMap[
          prestadorResumo
        ] || 0
      ) + 1;

    itens.push({

      ocorrencia:
        String(r[0] || ""),

      id:
        String(r[1] || ""),

      equipamento:
        String(r[2] || ""),

      dataAbertura:
        serializeValue_(
          dataAbertura
        ) || "",

      dataConclusao:
        serializeValue_(
          dataConclusao
        ) || "",

      reportadoPor:
        String(r[4] || ""),

      descricao:
        String(r[6] || ""),

      fotoAbertura:
        String(r[7] || ""),

      responsavel:
        String(r[9] || ""),

      solucao:
        String(r[12] || ""),

      fotoConclusao:
        String(r[13] || ""),

      categoria:
        categoria,

      componente:
        componente,

      prestador:
        prestador,

      pavimento:
        pavimento,

      localizacao:
        localizacao,

      localDetalhado:
        String(
          ativo.local_detalhado || ""
        ),

      tempoHoras:
        tempoHoras === null
          ? null
          : Number(
              tempoHoras.toFixed(1)
            )

    });
  }

  itens.sort(
    function(a,b) {

      return (
        new Date(
          b.dataConclusao
        ) -
        new Date(
          a.dataConclusao
        )
      );
    }
  );

  var categorias =
    Object.keys(
      categoriasMap
    )
    .map(
      function(nome) {

        return {

          nome:
            nome,

          total:
            categoriasMap[nome]

        };
      }
    )
    .sort(
      function(a,b) {

        if (
          b.total !==
          a.total
        ) {

          return (
            b.total -
            a.total
          );
        }

        return a.nome
          .localeCompare(
            b.nome,
            "pt-BR"
          );
      }
    );

  var prestadores =
    Object.keys(
      prestadoresMap
    )
    .map(
      function(nome) {

        return {

          nome:
            nome,

          total:
            prestadoresMap[nome]

        };
      }
    )
    .sort(
      function(a,b) {

        if (
          b.total !==
          a.total
        ) {

          return (
            b.total -
            a.total
          );
        }

        return a.nome
          .localeCompare(
            b.nome,
            "pt-BR"
          );
      }
    );

  return {

    periodo:{

      dataInicial:
        Utilities.formatDate(
          dataInicial,
          Session.getScriptTimeZone(),
          "yyyy-MM-dd"
        ),

      dataFinal:
        Utilities.formatDate(
          dataFinal,
          Session.getScriptTimeZone(),
          "yyyy-MM-dd"
        ),

      descricao:
        formatarDataRelatorioOC_(
          dataInicial
        ) +
        " a " +
        formatarDataRelatorioOC_(
          dataFinal
        )

    },

    filtros:{

      prestador:
        String(
          filtros.prestador || ""
        ),

      categoria:
        String(
          filtros.categoria || ""
        ),

      componente:
        String(
          filtros.componente || ""
        ),

      pavimento:
        String(
          filtros.pavimento || ""
        ),

      localizacao:
        String(
          filtros.localizacao || ""
        )

    },

    summary:{

      total:
        itens.length,

      tempoMedioHoras:
        qtdTempos
          ? Number(
              (
                somaHoras /
                qtdTempos
              ).toFixed(1)
            )
          : null,

      categorias:
        categorias.length,

      prestadores:
        prestadores.length

    },

    categorias:
      categorias,

    prestadores:
      prestadores,

    ocorrencias:
      itens

  };
}


function getOrCreateOccurrenceReportFolder_() {

  return getOrCreateFolder_(
    CONFIG.OCCURRENCE_REPORT_FOLDER_NAME
  );
}


function gerarPdfRelatorioOCs_(data) {

  var nomeBase =
    "QRManut_Relatorio_OC_" +
    data.periodo.dataInicial +
    "_a_" +
    data.periodo.dataFinal;

  var doc =
    DocumentApp.create(
      nomeBase
    );

  var body =
    doc.getBody();

  body.clear();

  body.appendParagraph(
    "QRManut – Relatório de OCs Concluídas"
  )
  .setHeading(
    DocumentApp.ParagraphHeading.TITLE
  );

  body.appendParagraph(
    "Período de conclusão: " +
    data.periodo.descricao
  );

  var filtrosAtivos = [];

  if (data.filtros.prestador) {
    filtrosAtivos.push(
      "Prestador: " +
      data.filtros.prestador
    );
  }

  if (data.filtros.categoria) {
    filtrosAtivos.push(
      "Categoria: " +
      data.filtros.categoria
    );
  }

  if (data.filtros.componente) {
    filtrosAtivos.push(
      "Componente: " +
      data.filtros.componente
    );
  }

  if (data.filtros.pavimento) {
    filtrosAtivos.push(
      "Pavimento: " +
      data.filtros.pavimento
    );
  }

  if (data.filtros.localizacao) {
    filtrosAtivos.push(
      "Localização: " +
      data.filtros.localizacao
    );
  }

  body.appendParagraph(
    "Filtros: " +
    (
      filtrosAtivos.length
        ? filtrosAtivos.join(" | ")
        : "Nenhum filtro adicional"
    )
  );

  body.appendParagraph(
    "Gerado em: " +
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "dd/MM/yyyy HH:mm"
    )
  );

  body.appendParagraph(
    "Resumo"
  )
  .setHeading(
    DocumentApp.ParagraphHeading.HEADING1
  );

  var tabelaResumo =
    body.appendTable([
      [
        "OCs concluídas",
        "Tempo médio",
        "Categorias",
        "Prestadores"
      ],
      [
        String(
          data.summary.total
        ),
        formatarHorasRelatorioOC_(
          data.summary.tempoMedioHoras
        ),
        String(
          data.summary.categorias
        ),
        String(
          data.summary.prestadores
        )
      ]
    ]);

  for (
    var c = 0;
    c < 4;
    c++
  ) {

    tabelaResumo
      .getRow(0)
      .getCell(c)
      .editAsText()
      .setBold(true);
  }

  body.appendParagraph(
    "Distribuição por categoria"
  )
  .setHeading(
    DocumentApp.ParagraphHeading.HEADING1
  );

  if (
    !data.categorias.length
  ) {

    body.appendParagraph(
      "Nenhuma OC concluída no período informado."
    );

  } else {

    var linhasCategoria = [
      [
        "Categoria",
        "Quantidade"
      ]
    ];

    data.categorias.forEach(
      function(item) {

        linhasCategoria.push([
          String(item.nome),
          String(item.total)
        ]);
      }
    );

    var tabelaCategorias =
      body.appendTable(
        linhasCategoria
      );

    tabelaCategorias
      .getRow(0)
      .getCell(0)
      .editAsText()
      .setBold(true);

    tabelaCategorias
      .getRow(0)
      .getCell(1)
      .editAsText()
      .setBold(true);
  }

  body.appendParagraph(
    "Detalhamento das OCs"
  )
  .setHeading(
    DocumentApp.ParagraphHeading.HEADING1
  );

  if (
    !data.ocorrencias.length
  ) {

    body.appendParagraph(
      "Nenhuma OC concluída encontrada para o período e filtros informados."
    );

  } else {

    data.ocorrencias.forEach(
      function(item) {

        body.appendParagraph(
          String(
            item.ocorrencia || ""
          ) +
          " – " +
          String(
            item.id || ""
          ) +
          " – " +
          String(
            item.equipamento || ""
          )
        )
        .setHeading(
          DocumentApp.ParagraphHeading.HEADING2
        );

        body.appendParagraph(
          "Abertura: " +
          formatarDataHoraRelatorio_(
            item.dataAbertura
          )
        );

        body.appendParagraph(
          "Conclusão: " +
          formatarDataHoraRelatorio_(
            item.dataConclusao
          )
        );

        body.appendParagraph(
          "Tempo até a conclusão: " +
          formatarHorasRelatorioOC_(
            item.tempoHoras
          )
        );

        body.appendParagraph(
          "Prestador: " +
          (
            item.prestador ||
            "-"
          )
        );

        body.appendParagraph(
          "Pavimento: " +
          (
            item.pavimento ||
            "-"
          )
        );

        body.appendParagraph(
          "Localização: " +
          (
            item.localizacao ||
            "-"
          )
        );

        if (
          item.localDetalhado
        ) {

          body.appendParagraph(
            "Local detalhado: " +
            item.localDetalhado
          );
        }

        body.appendParagraph(
          "Categoria: " +
          (
            item.categoria ||
            "-"
          )
        );

        body.appendParagraph(
          "Componente: " +
          (
            item.componente ||
            "-"
          )
        );

        body.appendParagraph(
          "Reportado por: " +
          (
            item.reportadoPor ||
            "-"
          )
        );

        body.appendParagraph(
          "Responsável: " +
          (
            item.responsavel ||
            "-"
          )
        );

        if (
          item.descricao
        ) {

          body.appendParagraph(
            "Descrição: " +
            item.descricao
          );
        }

        if (
          item.solucao
        ) {

          body.appendParagraph(
            "Solução: " +
            item.solucao
          );
        }

        adicionarLinkPdfRelatorio_(
          body,
          "Foto da abertura",
          item.fotoAbertura
        );

        adicionarLinkPdfRelatorio_(
          body,
          "Foto da conclusão",
          item.fotoConclusao
        );

        body.appendHorizontalRule();
      }
    );
  }

  body.appendParagraph(
    "Relatório gerado automaticamente pelo QRManut. " +
    "O período considera a Data de conclusão das ocorrências."
  );

  doc.saveAndClose();

  var arquivoTemporario =
    DriveApp.getFileById(
      doc.getId()
    );

  try {

    return arquivoTemporario
      .getAs(
        MimeType.PDF
      )
      .setName(
        nomeBase +
        ".pdf"
      );

  } finally {

    arquivoTemporario.setTrashed(
      true
    );
  }
}


function criarPdfRelatorioOCs_(body) {

  var data =
    getOccurrenceReport_({

      dataInicial:
        body.dataInicial,

      dataFinal:
        body.dataFinal,

      prestador:
        body.occProvider,

      categoria:
        body.occCategory,

      componente:
        body.occComponent,

      pavimento:
        body.occFloor,

      localizacao:
        body.occLocation

    });

  var pdf =
    gerarPdfRelatorioOCs_(
      data
    );

  var folder =
    getOrCreateOccurrenceReportFolder_();

  var file =
    folder.createFile(
      pdf
    );

  aplicarPermissaoFoto_(
    file
  );

  return {

    ok:true,

    nome:
      file.getName(),

    url:
      file.getUrl(),

    periodo:
      data.periodo,

    summary:
      data.summary

  };
}



/* ============================================================
 * CATÁLOGO DE CATEGORIAS E COMPONENTES – 7.4.6
 * ============================================================ */

function getOccurrenceCategoriesSheet_(){
  var ss=getSpreadsheet_(),sh=ss.getSheetByName(CONFIG.OCCURRENCE_CATEGORIES_SHEET);
  if(!sh)sh=ss.insertSheet(CONFIG.OCCURRENCE_CATEGORIES_SHEET);
  return sh;
}

function getOccurrenceComponentsSheet_(){
  var ss=getSpreadsheet_(),sh=ss.getSheetByName(CONFIG.OCCURRENCE_COMPONENTS_SHEET);
  if(!sh)sh=ss.insertSheet(CONFIG.OCCURRENCE_COMPONENTS_SHEET);
  return sh;
}

function prepareOccurrenceCategoriesSheet_(){
  var sh=getOccurrenceCategoriesSheet_();
  var h=["ID Categoria","Nome PT","Nome EN","Ativo","Ordem"];
  sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");
  sh.setFrozenRows(1);
  sh.getRange(2,4,1000,1).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(["Sim","Não"],true).setAllowInvalid(false).build()
  );
  return sh;
}

function prepareOccurrenceComponentsSheet_(){
  var sh=getOccurrenceComponentsSheet_();
  var h=["ID Componente","ID Categoria","Nome PT","Nome EN","Ativo","Ordem"];
  sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");
  sh.setFrozenRows(1);
  sh.getRange(2,5,2000,1).setDataValidation(
    SpreadsheetApp.newDataValidation().requireValueInList(["Sim","Não"],true).setAllowInvalid(false).build()
  );
  return sh;
}

function seedOccurrenceCatalog746_(){
  var csh=prepareOccurrenceCategoriesSheet_(),xsh=prepareOccurrenceComponentsSheet_();
  if(csh.getLastRow()>1 || xsh.getLastRow()>1)return;

  var cats=[
    ["CAT-001","Civil","Civil","Sim",10],
    ["CAT-002","Sanitário","Sanitary","Sim",20],
    ["CAT-003","Elétrica","Electrical","Sim",30],
    ["CAT-004","Hidráulica","Hydraulic","Sim",40],
    ["CAT-005","Climatização","HVAC","Sim",50],
    ["CAT-006","Refrigeração","Refrigeration","Sim",60],
    ["CAT-007","Utilidades","Utilities","Sim",70],
    ["CAT-008","Segurança","Safety","Sim",80],
    ["CAT-009","Mobiliário","Furniture","Sim",90],
    ["CAT-010","Equipamento","Equipment","Sim",100],
    ["CAT-011","Outros","Other","Sim",110]
  ];
  csh.getRange(2,1,cats.length,cats[0].length).setValues(cats);

  var map={
    "CAT-001":["Geral","Piso","Parede","Teto","Porta","Janela"],
    "CAT-002":["Geral","Vaso Sanitário","Pia","Torneira","Descarga","Mictório","Ralo"],
    "CAT-003":["Geral","Luminária","Tomada","Interruptor","Painel","Motor"],
    "CAT-004":["Geral","Tubulação","Registro","Bomba","Pia","Torneira","Ralo"],
    "CAT-005":["Geral","Ar-condicionado","Motor","Bomba","Painel","Tubulação"],
    "CAT-006":["Geral","Ar-condicionado","Motor","Bomba","Painel","Tubulação"],
    "CAT-007":["Geral","Bomba","Motor","Painel","Tubulação","Registro"],
    "CAT-008":["Geral","Porta","Painel","Outro"],
    "CAT-009":["Geral","Mobiliário","Outro"],
    "CAT-010":["Geral","Motor","Bomba","Painel","Ar-condicionado","Outro"],
    "CAT-011":["Geral","Outro"]
  };

  var english={
    "Geral":"General","Piso":"Floor","Parede":"Wall","Teto":"Ceiling","Porta":"Door","Janela":"Window",
    "Vaso Sanitário":"Toilet","Pia":"Sink","Torneira":"Faucet","Descarga":"Flush","Mictório":"Urinal","Ralo":"Drain",
    "Luminária":"Light Fixture","Tomada":"Outlet","Interruptor":"Switch","Painel":"Panel","Motor":"Motor",
    "Tubulação":"Piping","Registro":"Valve","Bomba":"Pump","Ar-condicionado":"Air Conditioner",
    "Mobiliário":"Furniture","Outro":"Other"
  };

  var rows=[],n=1;
  Object.keys(map).forEach(function(catId){
    map[catId].forEach(function(nome,i){
      rows.push(["CMP-"+Utilities.formatString("%04d",n++),catId,nome,english[nome]||nome,"Sim",(i+1)*10]);
    });
  });
  if(rows.length)xsh.getRange(2,1,rows.length,rows[0].length).setValues(rows);
}

function readOccurrenceCategories_(includeInactive){
  var v=prepareOccurrenceCategoriesSheet_().getDataRange().getDisplayValues(),r=[];
  for(var i=1;i<v.length;i++){
    var x=v[i],id=String(x[0]||"").trim();
    if(!id)continue;
    var item={row:i+1,idCategoria:id,nomePt:String(x[1]||"").trim(),nomeEn:String(x[2]||"").trim(),ativo:normalizarBusca_(x[3]||"Sim")!=="nao",ordem:Number(x[4]||0)};
    if(includeInactive||item.ativo)r.push(item);
  }
  return r.sort(function(a,b){return (a.ordem-b.ordem)||a.nomePt.localeCompare(b.nomePt,"pt-BR");});
}

function readOccurrenceComponents_(includeInactive){
  var v=prepareOccurrenceComponentsSheet_().getDataRange().getDisplayValues(),r=[];
  for(var i=1;i<v.length;i++){
    var x=v[i],id=String(x[0]||"").trim();
    if(!id)continue;
    var item={row:i+1,idComponente:id,idCategoria:String(x[1]||"").trim(),nomePt:String(x[2]||"").trim(),nomeEn:String(x[3]||"").trim(),ativo:normalizarBusca_(x[4]||"Sim")!=="nao",ordem:Number(x[5]||0)};
    if(includeInactive||item.ativo)r.push(item);
  }
  return r.sort(function(a,b){return (a.ordem-b.ordem)||a.nomePt.localeCompare(b.nomePt,"pt-BR");});
}

function occurrenceCatalogPublic_(){
  seedOccurrenceCatalog746_();
  return {
    categorias:readOccurrenceCategories_(false),
    componentes:readOccurrenceComponents_(false)
  };
}

function occurrenceCatalogAdmin_(s){
  if(!s||["MASTER","GESTOR"].indexOf(s.perfil)===-1)throw new Error("Somente MASTER ou GESTOR pode administrar categorias e componentes.");
  seedOccurrenceCatalog746_();
  return {categorias:readOccurrenceCategories_(true),componentes:readOccurrenceComponents_(true)};
}

function nextOccurrenceCategoryId_(){
  var n=0;readOccurrenceCategories_(true).forEach(function(x){var m=x.idCategoria.match(/^CAT-(\d+)$/i);if(m)n=Math.max(n,Number(m[1]));});
  return "CAT-"+Utilities.formatString("%03d",n+1);
}

function nextOccurrenceComponentId_(){
  var n=0;readOccurrenceComponents_(true).forEach(function(x){var m=x.idComponente.match(/^CMP-(\d+)$/i);if(m)n=Math.max(n,Number(m[1]));});
  return "CMP-"+Utilities.formatString("%04d",n+1);
}


function syncOccurrenceCatalogValidations_(){
  seedOccurrenceCatalog746_();

  var sh=prepareHistorySheet_();
  var categorias=readOccurrenceCategories_(false).map(function(x){return x.nomePt;});
  var componentesMap={};

  readOccurrenceComponents_(false).forEach(function(x){
    if(x.nomePt)componentesMap[x.nomePt]=1;
  });

  var componentes=Object.keys(componentesMap).sort(function(a,b){
    return a.localeCompare(b,"pt-BR");
  });

  var totalRows=Math.max(5000,sh.getMaxRows()-1);

  if(categorias.length){
    var regraCategorias=SpreadsheetApp
      .newDataValidation()
      .requireValueInList(categorias,true)
      .setAllowInvalid(false)
      .build();

    sh.getRange(2,15,totalRows,1).setDataValidation(regraCategorias);
  }else{
    sh.getRange(2,15,totalRows,1).clearDataValidations();
  }

  if(componentes.length){
    var regraComponentes=SpreadsheetApp
      .newDataValidation()
      .requireValueInList(componentes,true)
      .setAllowInvalid(false)
      .build();

    sh.getRange(2,16,totalRows,1).setDataValidation(regraComponentes);
  }else{
    sh.getRange(2,16,totalRows,1).clearDataValidations();
  }

  SpreadsheetApp.flush();

  return {
    categorias:categorias.length,
    componentes:componentes.length
  };
}

function configurarQRManut747(){
  configurarQRManut7462();
  try{CacheService.getScriptCache().removeAll([]);}catch(e){}
  Logger.log("QRManut 7.4.7 configurado: otimização de carregamento da ficha ativa.");
}

function configurarQRManut7462(){
  configurarQRManut746();
  var r=syncOccurrenceCatalogValidations_();
  Logger.log(
    "QRManut 7.4.6.2 configurado. Categorias: "+
    r.categorias+
    " | Componentes: "+
    r.componentes
  );
}

function saveOccurrenceCategory_(b,s){
  if(!s||["MASTER","GESTOR"].indexOf(s.perfil)===-1)throw new Error("Somente MASTER ou GESTOR pode alterar categorias.");
  var id=String(b.catalogCategoryId||"").trim(),pt=String(b.catalogCategoryPt||"").trim(),en=String(b.catalogCategoryEn||"").trim();
  if(!pt)throw new Error("Informe o nome da categoria.");
  var sh=prepareOccurrenceCategoriesSheet_(),all=readOccurrenceCategories_(true),existing=all.find(function(x){return x.idCategoria===id;});
  if(!id)id=nextOccurrenceCategoryId_();
  var row=existing?existing.row:sh.getLastRow()+1;
  sh.getRange(row,1,1,5).setValues([[id,pt,en||pt,sim_(b.catalogCategoryActive)?"Sim":"Não",Number(b.catalogCategoryOrder||0)]]);
  audit741_(s,existing?"CATEGORIA_ALTERADA":"CATEGORIA_CRIADA","CATEGORIA_OCORRENCIA",id,"","SUCESSO",pt);
  syncOccurrenceCatalogValidations_();
  return {ok:true,idCategoria:id};
}

function saveOccurrenceComponent_(b,s){
  if(!s||["MASTER","GESTOR"].indexOf(s.perfil)===-1)throw new Error("Somente MASTER ou GESTOR pode alterar componentes.");
  var id=String(b.catalogComponentId||"").trim(),cat=String(b.catalogComponentCategoryId||"").trim(),pt=String(b.catalogComponentPt||"").trim(),en=String(b.catalogComponentEn||"").trim();
  if(!cat)throw new Error("Selecione a categoria.");
  if(!pt)throw new Error("Informe o nome do componente.");
  if(!readOccurrenceCategories_(true).some(function(x){return x.idCategoria===cat;}))throw new Error("Categoria não encontrada.");
  var sh=prepareOccurrenceComponentsSheet_(),all=readOccurrenceComponents_(true),existing=all.find(function(x){return x.idComponente===id;});
  if(!id)id=nextOccurrenceComponentId_();
  var row=existing?existing.row:sh.getLastRow()+1;
  sh.getRange(row,1,1,6).setValues([[id,cat,pt,en||pt,sim_(b.catalogComponentActive)?"Sim":"Não",Number(b.catalogComponentOrder||0)]]);
  audit741_(s,existing?"COMPONENTE_ALTERADO":"COMPONENTE_CRIADO","COMPONENTE_OCORRENCIA",id,"","SUCESSO",pt);
  syncOccurrenceCatalogValidations_();
  return {ok:true,idComponente:id};
}

function occurrenceCategoryByPt_(nome){
  var n=normalizarBusca_(nome);
  return readOccurrenceCategories_(false).find(function(x){return normalizarBusca_(x.nomePt)===n;})||null;
}

function validarCategoriaOcorrencia746_(categoria){
  if(!occurrenceCategoryByPt_(categoria))throw new Error("Categoria inválida ou inativa.");
}

function validarComponenteAfetado746_(componente,categoria){
  var cat=occurrenceCategoryByPt_(categoria);
  if(!cat)throw new Error("Categoria inválida ou inativa.");
  var nc=normalizarBusca_(componente);
  var ok=readOccurrenceComponents_(false).some(function(x){return x.idCategoria===cat.idCategoria&&normalizarBusca_(x.nomePt)===nc;});
  if(!ok)throw new Error("Componente inválido para a categoria selecionada.");
}


/* ============================================================
 * PERFORMANCE DA FICHA – 7.4.7
 * ============================================================ */

function assetCacheKey747_(id){
  return "qrmanut_asset_747_"+normalizarId_(id);
}

function getAssetBasic747_(id){
  id=normalizarId_(id);
  if(!id)throw new Error("ID do ativo não informado.");

  var cache=CacheService.getScriptCache();
  var key=assetCacheKey747_(id);
  var cached=cache.get(key);

  if(cached){
    try{return JSON.parse(cached);}catch(e){}
  }

  var asset=getAssetById_(id);
  if(!asset)throw new Error("Ativo não encontrado.");

  try{
    cache.put(key,JSON.stringify(asset),300);
  }catch(e){}

  return asset;
}

function getAssetStatus747_(id){
  var s=getActiveOccurrenceStatus_(id);
  return s||{
    nivel:"ok",
    icone:"✅",
    situacao:"Sem ocorrências ativas",
    totalAtivas:0
  };
}

function invalidateAssetCache747_(id){
  try{
    CacheService.getScriptCache().remove(assetCacheKey747_(id));
  }catch(e){}
}

/* ============================================================
 * GET
 * ============================================================ */

function doGet(e) {
  try {
    var p=e&&e.parameter?e.parameter:{};
    if(p.ping)return jsonResponse_({ok:true,app:"QRManut",version:CONFIG.VERSION,message:"API online"});
    var action=String(p.action||"").trim().toLowerCase();

    if(action==="systemsession"){var s=getSystemSession_(p.systemSession||"");return jsonResponse_({ok:!!s,session:s||null});}
    if(action==="validatetoken")return jsonResponse_(validarTokenPublico_(p.authToken||"",String(p.authTokenType||"ATIVACAO").toUpperCase()));
    if(action==="users"){var su=validarSessaoSistema_(p.systemSession||"");return jsonResponse_({ok:true,users:listarUsuarios_(su)});}
    if(action==="providers"){var sp=validarSessaoSistema_(p.systemSession||"");return jsonResponse_({ok:true,providers:listarPrestadoresParaUsuario_(sp)});}
    if(action==="appconfig")return jsonResponse_(getPublicAppConfig_());
    if(action==="assetbasic")return jsonResponse_({ok:true,data:getAssetBasic747_(p.id)});
    if(action==="assetstatus")return jsonResponse_({ok:true,data:getAssetStatus747_(p.id)});
    if(action==="occurrencecatalog")return jsonResponse_({ok:true,data:occurrenceCatalogPublic_()});
    if(action==="occurrencecatalogadmin"){var soc=validarSessaoSistema_(p.systemSession||"");return jsonResponse_({ok:true,data:occurrenceCatalogAdmin_(soc)});}
    if(action==="companyconfig"){var sc=validarSessaoSistema_(p.systemSession||"");if(sc.perfil!=="MASTER")throw new Error("Somente MASTER pode consultar esta configuração.");return jsonResponse_({ok:true,config:getCompanyConfig_()});}
    if(action==="providersadmin"){var spa=validarSessaoSistema_(p.systemSession||"");return jsonResponse_({ok:true,providers:listProvidersAdmin_(spa)});}
    if(action==="auditfilters"){var sa=validarSessaoSistema_(p.systemSession||"");if(sa.perfil!=="MASTER")throw new Error("Somente MASTER pode consultar a auditoria.");return jsonResponse_({ok:true,filters:getAuditFilters_()});}
    if(action==="audit"){var sar=validarSessaoSistema_(p.systemSession||"");return jsonResponse_({ok:true,data:getAuditRecords_({dataInicial:p.dataInicial||"",dataFinal:p.dataFinal||"",acao:p.acao||"",resultado:p.resultado||"",usuario:p.usuario||"",q:p.q||""},sar)});}
    if(action==="assetbundle"){
      var bid=String(p.id||"").trim();
      if(!bid)return jsonResponse_({ok:false,error:"missing_id"});
      return jsonResponse_(buildAssetBundle_(bid));
    }
    if(action==="search"){var pt=Date.now(),ss=validarSessaoSistema_(p.systemSession||""),r=filtrarBuscaSistema_(buscarAtivos_(p.q||""),ss),pms=recordPerformance_("search",pt,ss,"q="+String(p.q||""));return jsonResponse_({ok:true,total:r.length,results:r,performanceMs:pms});}
    if(action==="documents"){var pt=Date.now(),sd=validarSessaoSistema_(p.systemSession||""),d=filtrarDocumentosSistema_(buscarDocumentosTecnicos_(p.q||"",p.tipo||"",p.disciplina||"",p.pavimento||""),sd),pms=recordPerformance_("documents",pt,sd,"total="+d.length);return jsonResponse_({ok:true,total:d.length,documents:d,performanceMs:pms});}
    if(action==="documentfilters")return jsonResponse_({ok:true,filters:getTechnicalDocumentFiltersForSystem_(validarSessaoSistema_(p.systemSession||""))});
    if(action==="documentuploadmeta"){var du=validarSessaoSistema_(p.systemSession||"");return jsonResponse_({ok:true,data:getDocumentUploadMetadata_(du)});}
    if(action==="occurrencereportfilters")return jsonResponse_({ok:true,filters:getOccurrenceReportFiltersForSystem_(validarSessaoSistema_(p.systemSession||""))});
    if(action==="occurrencereport"){var pt=Date.now(),sr=validarSessaoSistema_(p.systemSession||""),pr=isWideScopeSession_(sr)?(p.prestador||""):sr.prestador,rd=getOccurrenceReport_({dataInicial:p.dataInicial||"",dataFinal:p.dataFinal||"",prestador:pr,categoria:p.categoria||"",componente:p.componente||"",pavimento:p.pavimento||"",localizacao:p.localizacao||""}),pms=recordPerformance_("occurrencereport",pt,sr,"");return jsonResponse_({ok:true,data:rd,performanceMs:pms});}
    if(action==="pendingfilters"){var sf=validarSessaoSistema_(p.systemSession||"");return jsonResponse_({ok:true,filters:getPendingFiltersForSystem_(sf)});}
    if(action==="pending"){var pt=Date.now(),sx=validarSessaoSistema_(p.systemSession||""),pd=filtrarPendenciasSistema_(getPendingOccurrences_(),sx,{prestador:p.prestador||"",status:p.status||"",categoria:p.categoria||"",pavimento:p.pavimento||"",localizacao:p.localizacao||""}),pms=recordPerformance_("pending",pt,sx,"total="+pd.occurrences.length);return jsonResponse_({ok:true,summary:pd.summary,occurrences:pd.occurrences,performanceMs:pms});}
    if(action==="preventiverequirements"){var s1=validarSessaoSistema_(p.systemSession||p.session||""),a1=findEquipmentById_(readEquipmentSheet_(),p.id||"");if(!a1)throw new Error("Ativo não encontrado.");authorizePreventive_(s1,a1);return jsonResponse_({ok:true,data:getEffectivePreventiveRequirements_(s1,a1.prestador)});}
    if(action==="preventivecontrol"){var s2=validarSessaoSistema_(p.systemSession||p.session||"");return jsonResponse_({ok:true,data:getMonthlyPreventiveControl_(p.competencia||"",s2,p.prestador||"")});}

    var id=String(p.id||"").trim();
    if(action==="assetdocuments"){if(!id)return jsonResponse_({ok:false,error:"missing_id"});var ad=getTechnicalDocumentsByAsset_(id);return jsonResponse_({ok:true,total:ad.length,documents:ad});}
    if(action==="history"){if(!id)return jsonResponse_({ok:false,error:"missing_id"});return jsonResponse_({ok:true,history:getHistoryByEquipment_(id)});}
    if(action==="preventivehistory"){if(!id)return jsonResponse_({ok:false,error:"missing_id"});var st=p.systemSession||p.session||"";validarSessaoSistema_(st);return jsonResponse_({ok:true,preventives:getPreventiveHistoryByEquipment_(id,st)});}
    if(action==="status"){if(!id)return jsonResponse_({ok:false,error:"missing_id"});return jsonResponse_({ok:true,data:getEquipmentStatusSummary_(id)});}
    if(!id)return jsonResponse_({ok:false,error:"missing_id"});
    if(normId_(id)===CONFIG.SEARCH_ID)return jsonResponse_({ok:true,data:{id:CONFIG.SEARCH_ID,tipo:"busca"}});
    var ativo=findEquipmentById_(readEquipmentSheet_(),id);if(!ativo)return jsonResponse_({ok:false,error:"not_found"});return jsonResponse_({ok:true,data:buildEquipmentPayload_(ativo)});
  } catch(error) {return jsonResponse_({ok:false,error:"server_error",detail:String(error.message||error)});}
}

/* ============================================================
 * POST
 * ============================================================ */
function doPost(e) {
  try {
    var b=readPostBody_(e),action=String(b.action||"").trim().toLowerCase();
    if(action==="systemlogin")return jsonResponse_(loginSystem_(b));
    if(action==="forgotpassword")return jsonResponse_(solicitarRecuperacaoSenha_(b.recoveryIdentifier));
    if(action==="setpassword")return jsonResponse_(definirSenhaPorToken_(b));
    if(action===""||action==="reportoccurrence")return jsonResponse_(processReport_(b));
    if(action==="systemlogout")return jsonResponse_(logoutSystem_(b));

    var s=validarSessaoSistema_(b.systemSessionToken||b.preventiveSessionToken||"");
    if(action==="createuser")return jsonResponse_(criarUsuario_(b,s));
    if(action==="updateuserstatus")return jsonResponse_(atualizarStatusUsuario_(b,s));
    if(action==="resendinvite")return jsonResponse_(reenviarConvite_(b,s));
    if(action==="updatecompanyconfig")return jsonResponse_(updateCompanyConfig_(b,s));
    if(action==="createprovider")return jsonResponse_(createProvider_(b,s));
    if(action==="updateprovider")return jsonResponse_(updateProvider_(b,s));
    if(action==="uploaddocument")return jsonResponse_(uploadTechnicalDocument_(b,s));
    if(action==="saveoccurrencecategory")return jsonResponse_(saveOccurrenceCategory_(b,s));
    if(action==="saveoccurrencecomponent")return jsonResponse_(saveOccurrenceComponent_(b,s));
    if(action==="registerpreventive"){b.systemSessionToken=b.systemSessionToken||b.preventiveSessionToken;return jsonResponse_(processPreventive_(b));}
    if(action==="sendpreventivereport"){if(s.perfil==="CONSULTA")throw new Error("Seu perfil possui acesso somente leitura.");b.preventiveSessionToken=b.systemSessionToken||b.preventiveSessionToken;return jsonResponse_(enviarRelatorioPreventivas_(b));}
    if(action==="generateoccurrencereportpdf"){if(s.perfil==="CONSULTA")throw new Error("Seu perfil possui acesso somente leitura.");if(!isWideScopeSession_(s))b.occProvider=s.prestador;var pdf=criarPdfRelatorioOCs_(b);audit740_(s,"RELATORIO_GERADO","RELATORIO_OC",pdf.nome||"","","SUCESSO","");return jsonResponse_(pdf);}
    if(action==="updateoccurrence"){var au=authorizeOccurrenceChange_(s,b.ocorrencia);b.alteradoPor=s.nome||s.usuario;var rr=updateOccurrence_(b),sh=prepareHistorySheet_();sh.getRange(au.row,23).setValue(s.idUsuario||"");sh.getRange(au.row,24).setValue(s.idPrestador||providerIdFromName_(au.ativo.prestador)||"");audit740_(s,b.status==="Concluída"?"OC_CONCLUIDA":"OC_ALTERADA","OC",b.ocorrencia,au.ativo.id,"SUCESSO","");return jsonResponse_(rr);}
    throw new Error("Ação não reconhecida: "+action);
  } catch(error) {return jsonResponse_({ok:false,error:"server_error",detail:String(error.message||error)});}
}

