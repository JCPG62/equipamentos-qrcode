    );
  }

  if (
    !prestadorPermitido_(
      sessao,
      ativo.prestador
    )
  ) {

    throw new Error(
      "Acesso não autorizado."
    );
  }

  var values =
    preparePreventiveSheet_()
      .getDataRange()
      .getValues();

  var target =
    normId_(
      equipmentId
    );

  var result = [];

  for (
    var i = 1;
    i < values.length;
    i++
  ) {

    var r =
      values[i];

    if (
      normId_(r[1]) !==
      target
    ) {

      continue;
    }

    result.push({

      registro:
        String(r[0] || ""),

      id:
        String(r[1] || ""),

      equipamento:
        String(r[2] || ""),

      data:
        serializeValue_(r[3]) || "",

      competencia:
        String(r[4] || ""),

      periodicidade:
        String(r[5] || ""),

      prestador:
        String(r[6] || ""),

      responsavel:
        String(r[7] || ""),

      status:
        String(r[8] || ""),

      observacao:
        String(r[9] || ""),

      foto:
        String(r[10] || ""),

      assinatura:
        String(r[11] || ""),

      usuarioAcesso:
        String(r[15] || "")

    });
  }

  result.sort(
    function(a,b) {

      return (
        new Date(b.data) -
        new Date(a.data)
      );
    }
  );

  return result.slice(
    0,
    CONFIG.PREVENTIVE_HISTORY_LIMIT
  );
}


/* ============================================================
 * OC PENDENTES
 * ============================================================ */

function getPendingOccurrences_() {

  var values =
    prepareHistorySheet_()
      .getDataRange()
      .getValues();

  var ativos =
    readEquipmentSheet_();

  var mapa = {};

  ativos.forEach(
    function(a) {

      mapa[
        normId_(a.id)
      ] = a;
    }
  );

  var result = [];

  var summary = {

    abertas:0,
    emAtendimento:0,
    aguardandoPeca:0,
    total:0

  };

  for (
    var i = 1;
    i < values.length;
    i++
  ) {

    var r =
      values[i];

    var status =
      String(
        r[8] || ""
      );

    if (
      CONFIG.ACTIVE_STATUS
        .indexOf(status) === -1
    ) {

      continue;
    }

    if (
      status === "Aberta"
    ) {
      summary.abertas++;
    }

    if (
      status === "Em atendimento"
    ) {
      summary.emAtendimento++;
    }

    if (
      status === "Aguardando peça"
    ) {
      summary.aguardandoPeca++;
    }

    var ativo =
      mapa[
        normId_(r[1])
      ] || {};

    result.push({

      ocorrencia:
        String(r[0] || ""),

      id:
        String(r[1] || ""),

      nome:
        String(r[2] || ""),

      data:
        serializeValue_(r[3]) || "",

      descricao:
        String(r[6] || ""),

      foto:
        String(r[7] || ""),

      status:
        status,

      responsavel:
        String(r[9] || ""),

      dataInicio:
        serializeValue_(r[10]) || "",

      categoriaOcorrencia:
        String(r[14] || ""),

      componenteAfetado:
        String(r[15] || ""),

      prestador:
        ativo.prestador || "",

      pavimento:
        ativo.pavimento || "",

      localizacao:
        ativo.localizacao || "",

      localDetalhado:
        ativo.local_detalhado || "",

      ambiente:
        ativo.ambiente || ""

    });
  }

  summary.total =
    result.length;

  return {

    summary:
      summary,

    occurrences:
      result

  };
}


/* ============================================================
 * STATUS ATIVO
 * ============================================================ */

function getEquipmentStatusSummary_(equipmentId) {

  var history =
    getHistoryByEquipment_(
      equipmentId
    );

  var abertas = 0;
  var atendimento = 0;
  var aguardando = 0;

  history.forEach(
    function(item) {

      if (
        item.status === "Aberta"
      ) {
        abertas++;
      }

      if (
        item.status === "Em atendimento"
      ) {
        atendimento++;
      }

      if (
        item.status === "Aguardando peça"
      ) {
        aguardando++;
      }
    }
  );

  var total =
    abertas +
    atendimento +
    aguardando;

  if (
    abertas > 0
  ) {

    return {

      situacao:
        "Com ocorrência aberta",

      nivel:
        "critico",

      icone:
        "🔴",

      totalAtivas:
        total

    };
  }

  if (
    aguardando > 0
  ) {

    return {

      situacao:
        "Aguardando peça",

      nivel:
        "aguardando",

      icone:
        "🟠",

      totalAtivas:
        total

    };
  }

  if (
    atendimento > 0
  ) {

    return {

      situacao:
        "Em atendimento",

      nivel:
        "atendimento",

      icone:
        "🟡",

      totalAtivas:
        total

    };
  }

  return {

    situacao:
      "Sem ocorrências ativas",

    nivel:
      "ok",

    icone:
      "🟢",

    totalAtivas:
      0

  };
}


/* ============================================================
 * MAPA PREVENTIVA
 * ============================================================ */

function isPeriodicidadeMensal_(valor) {

  return (
    normalizarBusca_(valor) ===
    "mensal"
  );
}


function normalizarCompetenciaPreventiva_(valor) {

  if (!valor) {
    return "";
  }

  if (
    valor instanceof Date &&
    !isNaN(valor)
  ) {

    return Utilities.formatDate(
      valor,
      Session.getScriptTimeZone(),
      "yyyy-MM"
    );
  }

  var texto =
    String(valor)
      .trim();

  if (
    /^\d{4}-\d{2}$/.test(texto)
  ) {

    return texto;
  }

  var matchISO =
    texto.match(
      /^(\d{4})-(\d{2})/
    );

  if (matchISO) {

    return (
      matchISO[1] +
      "-" +
      matchISO[2]
    );
  }

  var matchBR =
    texto.match(
      /^(?:\d{1,2}\/)?(\d{1,2})\/(\d{4})$/
    );

  if (matchBR) {

    return (
      matchBR[2] +
      "-" +
      String(matchBR[1])
        .padStart(2,"0")
    );
  }

  return texto;
}


function getPreventiveMapByCompetencia_(competencia) {

  var values =
    preparePreventiveSheet_()
      .getDataRange()
      .getValues();

  var mapa = {};

  var competenciaAlvo =
    normalizarCompetenciaPreventiva_(
      competencia
    );

  for (
    var i = 1;
    i < values.length;
    i++
  ) {

    var r =
      values[i];

    var competenciaLinha =
      normalizarCompetenciaPreventiva_(
        r[4]
      );

    if (
      competenciaLinha !==
      competenciaAlvo
    ) {

      continue;
    }

    var id =
      normId_(
        r[1]
      );

    if (!id) {
      continue;
    }

    if (!mapa[id]) {

      mapa[id] = [];
    }

    mapa[id].push({

      registro:
        String(r[0] || ""),

      data:
        serializeValue_(r[3]) || "",

      competencia:
        competenciaLinha,

      prestador:
        String(r[6] || ""),

      responsavel:
        String(r[7] || ""),

      status:
        String(r[8] || ""),

      observacao:
        String(r[9] || ""),

      foto:
        String(r[10] || ""),

      assinatura:
        String(r[11] || ""),

      usuarioAcesso:
        String(r[15] || "")

    });
  }

  return mapa;
}


function testePreventivaAC102_72() {

  var competencia =
    "2026-08";

  var id =
    "AC102_SP3P";

  var mapa =
