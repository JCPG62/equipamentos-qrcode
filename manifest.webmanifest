/* ============================================================
 * E-MAIL DA OC
 * ============================================================ */

function enviarEmailPNCQ_(dados,fotoBlob) {

  var assunto =

    "[QRManut][" +
    dados.ocorrencia +
    "] " +
    dados.id +
    " - " +
    dados.nomeEquipamento;

  var corpo =

    "Nova ocorrência registrada no QRManut.\n\n" +

    "Ocorrência: " +
    dados.ocorrencia +
    "\n" +

    "Ativo: " +
    dados.id +
    " - " +
    dados.nomeEquipamento +
    "\n" +

    "Prestador: " +
    (
      dados.prestador ||
      "Não informado"
    ) +
    "\n" +

    "Pavimento: " +
    (
      dados.pavimento ||
      "-"
    ) +
    "\n" +

    "Localização: " +
    (
      dados.localizacao ||
      "-"
    ) +
    "\n\n" +

    "Categoria: " +
    dados.categoriaOcorrencia +
    "\n" +

    "Componente: " +
    dados.componenteAfetado +
    "\n\n" +

    "Reportado por: " +
    dados.reportadoPor +
    "\n\n" +

    "Descrição:\n" +
    dados.descricao;

  if (
    dados.fotoUrl
  ) {

    corpo +=

      "\n\nFoto:\n" +
      dados.fotoUrl;
  }

  var options = {

    to:
      CONFIG.NOTIFICATION_EMAIL_TO,

    cc:
      CONFIG.NOTIFICATION_EMAIL_CC,

    subject:
      assunto,

    body:
      corpo,

    name:
      "QRManut"

  };

  if (fotoBlob) {

    options.attachments = [
      fotoBlob
    ];
  }

  MailApp.sendEmail(
    options
  );
}


function enviarEmailPrestador_(dados,emails) {

  var assunto =

    "[QRManut][" +
    dados.ocorrencia +
    "] " +
    dados.id +
    " - " +
    dados.nomeEquipamento;

  var corpo =

    "Olá,\n\n" +

    "Uma nova ocorrência de manutenção foi registrada para um ativo sob responsabilidade deste prestador.\n\n" +

    "Ocorrência: " +
    dados.ocorrencia +
    "\n\n" +

    "Ativo: " +
    dados.id +
    " - " +
    dados.nomeEquipamento +
    "\n" +

    "Prestador: " +
    (
      dados.prestador ||
      "-"
    ) +
    "\n" +

    "Pavimento: " +
    (
      dados.pavimento ||
      "-"
    ) +
    "\n" +

    "Localização: " +
    (
      dados.localizacao ||
      "-"
    ) +
    "\n" +

    "Local detalhado: " +
    (
      dados.localDetalhado ||
      "-"
    ) +
    "\n\n" +

    "Categoria: " +
    dados.categoriaOcorrencia +
    "\n" +

    "Componente: " +
    dados.componenteAfetado +
    "\n\n" +

    "Descrição:\n" +
    dados.descricao +
    "\n\n" +

    "Reportado por: " +
    dados.reportadoPor;

  if (
    dados.fotoUrl
  ) {

    corpo +=

      "\n\nFoto da ocorrência:\n" +
      dados.fotoUrl;
  }

  corpo +=

    "\n\nMensagem automática do QRManut.";

  MailApp.sendEmail({

    to:
      emails.join(","),

    subject:
      assunto,

    body:
      corpo,

    name:
      "QRManut"

  });
}


/* ============================================================
 * NOVA OC
 * ============================================================ */

function validarCategoriaOcorrencia_(categoria){seedOccurrenceCatalog746_();validarCategoriaOcorrencia746_(categoria);}


function validarComponenteAfetado_(componente,categoria){seedOccurrenceCatalog746_();if(categoria)return validarComponenteAfetado746_(componente,categoria);var n=normalizarBusca_(componente),ok=readOccurrenceComponents_(false).some(function(x){return normalizarBusca_(x.nomePt)===n;});if(!ok)throw new Error("Componente inválido ou inativo.");}


function processReport_(body) {

  var id =
    normId_(
      body.id
    );

  if (!id) {

    throw new Error(
      "ID não informado."
    );
  }

  var ativo =
    findEquipmentById_(
      readEquipmentSheet_(),
      id
    );

  if (!ativo) {

    throw new Error(
      "Ativo não encontrado."
    );
  }

  validarCategoriaOcorrencia_(
    body.categoriaOcorrencia
  );

  validarComponenteAfetado_(
    body.componenteAfetado,
    body.categoriaOcorrencia
  );

  if (
    !String(
      body.reportadoPor
    ).trim() ||
    !String(
      body.descricao
    ).trim()
  ) {

    throw new Error(
      "Preencha os campos obrigatórios."
    );
  }

  var registro =
    gerarNumeroOcorrencia_();

  var agora =
    new Date();

  var foto =
    savePhotoFromBase64_(
      body.fotoBase64,
      body.fotoMime,
      body.fotoNome,
      id,
      registro,
      "ABERTURA"
    );

  var sh =
    prepareHistorySheet_();

  sh.appendRow([

    registro,
    id,
    ativo.nome_do_equipamento || "",
    agora,
    body.reportadoPor,
    body.contato || "",
    body.descricao,
    foto.url || "",
    CONFIG.DEFAULT_STATUS,
    "",
    "",
    "",
    "",
    "",
    body.categoriaOcorrencia,
    body.componenteAfetado,
    "",
    "",
    "Não",
    "",
    "",
    "",
    "",
    providerIdFromName_(ativo.prestador) || ""

  ]);

  var row =
    sh.getLastRow();

  var dados = {

    ocorrencia:
      registro,

    id:
      id,

    nomeEquipamento:
      ativo.nome_do_equipamento || "",

    prestador:
      ativo.prestador || "",

    pavimento:
      ativo.pavimento || "",

    localizacao:
      ativo.localizacao || "",

    localDetalhado:
      ativo.local_detalhado || "",

    categoriaOcorrencia:
      body.categoriaOcorrencia,

    componenteAfetado:
      body.componenteAfetado,

    descricao:
      body.descricao,

    reportadoPor:
      body.reportadoPor,

    fotoUrl:
      foto.url || ""

  };


  try {

    enviarEmailPNCQ_(
      dados,
      foto.blob
    );

  } catch(error) {

    Logger.log(
      "Erro e-mail PNCQ: " +
      error
    );
  }


  var config =
    getProviderNotificationConfig_(
      ativo.prestador
    );

  var statusNotificacao =
    "Não";

  var emailPrestador =
    config.emailString ||
    "";

  if (
    config.notificar
  ) {

    if (
      !config.emails.length
    ) {

      statusNotificacao =
        "Não - sem e-mail";

    } else {

      try {

        enviarEmailPrestador_(
          dados,
          config.emails
        );

        statusNotificacao =
          "Sim";

      } catch(error) {

        statusNotificacao =
          "Erro";

        Logger.log(
          "Erro e-mail prestador: " +
          error
        );
      }
    }
  }

  sh.getRange(
    row,
    19
  )
  .setValue(
    statusNotificacao
  );

  sh.getRange(
    row,
    20
  )
  .setValue(
    emailPrestador
  );

  SpreadsheetApp.flush();

  audit741_(
    {idUsuario:"",nome:String(body.reportadoPor||""),perfil:"PUBLICO"},
    "OC_CRIADA",
    "OC",
    registro,
    id,
    "SUCESSO",
    "Ocorrência criada pelo acesso público do QR Code."
  );

  return {

    ok:true,

    ocorrencia:
      registro,

    notificacaoPrestador:
      statusNotificacao,

    emailPrestador:
      emailPrestador

  };
}


/* ============================================================
 * LOCALIZA OC
 * ============================================================ */

function findOccurrenceRow_(occurrence) {

  var sh =
    prepareHistorySheet_();

  if (
    sh.getLastRow() <= 1
  ) {

    return 0;
  }

  var values =
    sh.getRange(
      2,
      1,
      sh.getLastRow() - 1,
      1
    )
    .getDisplayValues();

  var target =
    String(
      occurrence || ""
    )
    .trim()
    .toUpperCase();

  for (
    var i = 0;
    i < values.length;
    i++
  ) {

    if (
      String(
        values[i][0] || ""
      )
      .trim()
      .toUpperCase() ===
      target
    ) {

      return i + 2;
    }
  }

  return 0;
}


/* ============================================================
 * ATUALIZA OC
 * ============================================================ */

function updateOccurrence_(body) {

  var row =
    findOccurrenceRow_(
      body.ocorrencia
    );

  if (!row) {

    throw new Error(
      "Ocorrência não encontrada."
    );
  }

  validarCategoriaOcorrencia_(
    body.categoriaOcorrenciaEdit
  );

  validarComponenteAfetado_(
    body.componenteAfetadoEdit,
    body.categoriaOcorrenciaEdit
  );

  var sh =
    prepareHistorySheet_();

  var id =
    sh.getRange(
      row,
      2
    )
    .getValue();

  var fotoCorrecaoSalva=false;
  var fotoConclusaoSalva=false;
  var fotoCorrecaoUrl="";
  var fotoConclusaoUrl="";

  sh.getRange(row,7)
    .setValue(
      body.descricaoOcorrencia
    );

  sh.getRange(row,9)
    .setValue(
      body.status
    );

  sh.getRange(row,10)
    .setValue(
      body.responsavel || ""
    );

  sh.getRange(row,13)
    .setValue(
      body.solucao || ""
    );

  sh.getRange(row,15)
    .setValue(
      body.categoriaOcorrenciaEdit
    );

  sh.getRange(row,16)
    .setValue(
      body.componenteAfetadoEdit
    );


  if (
    body.fotoOcorrenciaBase64
  ) {

    var f1 =
      savePhotoFromBase64_(
        body.fotoOcorrenciaBase64,
        body.fotoOcorrenciaMime,
        body.fotoOcorrenciaNome,
        id,
        body.ocorrencia,
        "CORRECAO"
      );

    sh.getRange(
      row,
      8
    )
    .setValue(
      f1.url
    );

    fotoCorrecaoSalva=!!f1.url;
    fotoCorrecaoUrl=f1.url||"";
  }


  if (
    body.fotoConclusaoBase64
  ) {

    var f2 =
      savePhotoFromBase64_(
        body.fotoConclusaoBase64,
        body.fotoConclusaoMime,
        body.fotoConclusaoNome,
        id,
        body.ocorrencia,
        "CONCLUSAO"
      );

    sh.getRange(
      row,
      14
    )
    .setValue(
      f2.url
    );

    fotoConclusaoSalva=!!f2.url;
    fotoConclusaoUrl=f2.url||"";
  }


  var inicio =
    sh.getRange(
      row,
      11
    );

  var conclusao =
    sh.getRange(
      row,
      12
    );

  if (
    (
      body.status === "Em atendimento" ||
      body.status === "Aguardando peça" ||
      body.status === "Concluída"
    ) &&
    !inicio.getValue()
  ) {

    inicio.setValue(
      new Date()
    );
  }

  if (
    body.status === "Concluída" &&
    !conclusao.getValue()
  ) {

    conclusao.setValue(
      new Date()
    );
  }

  sh.getRange(
    row,
    17
  )
  .setValue(
    new Date()
  );

  sh.getRange(
    row,
    18
  )
  .setValue(
    body.alteradoPor
  );

  SpreadsheetApp.flush();

  return {
    ok:true,
    fotoCorrecaoSalva:fotoCorrecaoSalva,
    fotoConclusaoSalva:fotoConclusaoSalva,
    fotoCorrecaoUrl:fotoCorrecaoUrl,
    fotoConclusaoUrl:fotoConclusaoUrl
  };
}


/* ============================================================
 * REGISTRO PREVENTIVA
 * ============================================================ */

function findRecentPreventiveDuplicate_(
  id,
  competencia,
  responsavel,
  agora
) {

  var sh =
    preparePreventiveSheet_();

  if (
    sh.getLastRow() <= 1
  ) {

    return null;
  }

  var values =
    sh.getRange(
      2,
      1,
      sh.getLastRow() - 1,
      16
    )
    .getValues();

  var idAlvo =
    normId_(id);

  var competenciaAlvo =
    normalizarCompetenciaPreventiva_(
      competencia
    );

  var responsavelAlvo =
    normalizarBusca_(
      responsavel
    );

  var agoraMs =
    (
      agora instanceof Date
        ? agora
        : new Date(agora)
    )
    .getTime();

  var janelaMs =
    CONFIG.PREVENTIVE_DUPLICATE_WINDOW_MINUTES *
    60 *
    1000;

  /*
   * Percorre de baixo para cima porque os registros mais
   * recentes normalmente ficam no final da planilha.
   */
  for (
    var i = values.length - 1;
    i >= 0;
    i--
  ) {

    var r =
      values[i];

    if (
      normId_(r[1]) !== idAlvo
    ) {

      continue;
    }

    if (
      normalizarCompetenciaPreventiva_(
        r[4]
      ) !== competenciaAlvo
    ) {

      continue;
    }

    if (
      normalizarBusca_(
        r[7]
      ) !== responsavelAlvo
    ) {

      continue;
    }

    if (
      normalizarBusca_(
        r[8]
      ) !==
      normalizarBusca_(
        CONFIG.PREVENTIVE_STATUS
      )
    ) {

      continue;
    }

    var dataRegistro =
      r[3] instanceof Date
        ? r[3]
        : new Date(r[3]);

    if (
      isNaN(
        dataRegistro.getTime()
      )
    ) {

      continue;
    }

    var diferenca =
      agoraMs -
      dataRegistro.getTime();

    if (
      diferenca >= 0 &&
      diferenca <= janelaMs
    ) {

      return {

        registro:
          String(r[0] || ""),

        id:
          String(r[1] || ""),

        data:
          serializeValue_(
            dataRegistro
          ) || "",

        competencia:
          competenciaAlvo,

        responsavel:
          String(r[7] || ""),

        status:
          String(r[8] || "")

      };
    }
  }

  return null;
}


function gerarNumeroPreventivaSemLock_() {

  var sh =
    preparePreventiveSheet_();

  var maior = 0;

  if (
    sh.getLastRow() > 1
  ) {

    sh.getRange(
      2,
      1,
      sh.getLastRow() - 1,
      1
    )
    .getDisplayValues()
    .forEach(
      function(row) {

        var match =
          String(
            row[0] || ""
          )
          .match(
            /^PR-(\d+)$/i
          );

        if (match) {

          maior =
            Math.max(
              maior,
              Number(match[1])
            );
        }
      }
    );
  }

  return (
    "PR-" +
    Utilities.formatString(
      "%06d",
      maior + 1
    )
  );
}


function processPreventive_(body) {

  var sessao =
    validarSessaoSistema_(
      body.systemSessionToken ||
      body.preventiveSessionToken
    );

  var id =
    normId_(
      body.id
    );

  var ativo =
    findEquipmentById_(
      readEquipmentSheet_(),
      id
    );

  if (!ativo) {

    throw new Error(
      "Ativo não encontrado."
    );
  }

  authorizePreventive_(sessao,ativo);

  var requisitos =
    getEffectivePreventiveRequirements_(
      sessao,
      ativo.prestador
    );

  var responsavel =
    String(
      body.preventiveResponsible ||
      ""
    ).trim();

  var observacao =
    String(
      body.preventiveObservation ||
      ""
    ).trim();

  if (!responsavel) {

    throw new Error(
      "Informe o responsável."
    );
  }

  if (
    requisitos.observacaoObrigatoria &&
    !observacao
  ) {

    throw new Error(
      "A observação é obrigatória."
    );
  }

  if (
    requisitos.fotoObrigatoria &&
    !body.preventivePhotoBase64
  ) {

    throw new Error(
      "A foto é obrigatória."
    );
  }

  if (
    requisitos.exigirAssinatura &&
    !body.preventiveSignatureBase64
  ) {

    throw new Error(
      "A assinatura é obrigatória."
    );
  }

  var data =
    new Date();

  var competencia =
    getCompetencia_(data);

  /*
   * A proteção principal fica no servidor.
   * Duas requisições não podem consultar/gravar a preventiva
   * ao mesmo tempo, mesmo que venham do mesmo ou de outro aparelho.
   */
  var lock =
    LockService.getScriptLock();

  lock.waitLock(
    60000
  );

  try {

    var duplicada =
      findRecentPreventiveDuplicate_(
        id,
        competencia,
        responsavel,
        data
      );

    if (duplicada) {

      audit741_(
        sessao,
        "PREVENTIVA_DUPLICIDADE_BLOQUEADA",
        "PREVENTIVA",
        duplicada.registro,
        id,
        "BLOQUEADO",
        "Novo envio bloqueado pela janela de "+CONFIG.PREVENTIVE_DUPLICATE_WINDOW_MINUTES+" minutos."
      );

      return {

        ok:true,

        duplicatePrevented:true,

        registro:
          duplicada.registro,

        competencia:
          duplicada.competencia,

        dataRegistro:
          duplicada.data,

        message:
          "Esta preventiva já havia sido registrada. Uma nova gravação foi bloqueada para evitar duplicidade."

      };
    }

    /*
     * Como o LockService já está ativo, não usamos aqui a função
     * gerarNumeroPreventiva_(), que possui seu próprio lock.
     */
    var registro =
      gerarNumeroPreventivaSemLock_();

    var foto =
      savePreventivePhoto_(
        body.preventivePhotoBase64,
        body.preventivePhotoMime,
        body.preventivePhotoName,
        id,
        registro
      );

    var assinatura =
      savePreventiveSignature_(
        body.preventiveSignatureBase64,
        body.preventiveSignatureMime,
        id,
        registro
      );

    preparePreventiveSheet_()
      .appendRow([

        registro,
        id,
        ativo.nome_do_equipamento || "",
        data,
        competencia,
        ativo.periodicidade || "",
        ativo.prestador || "",
        responsavel,
        CONFIG.PREVENTIVE_STATUS,
        observacao,
        foto.url || "",
        assinatura.url || "",
        requisitos.exigirAssinatura
          ? "Sim"
          : "Não",
        requisitos.fotoObrigatoria
          ? "Sim"
          : "Não",
        requisitos.observacaoObrigatoria
          ? "Sim"
          : "Não",
        sessao.usuario || "",
        sessao.idUsuario || "",
        sessao.idPrestador || providerIdFromName_(ativo.prestador) || ""

      ]);

    SpreadsheetApp.flush();

    audit741_(
      sessao,
      "PREVENTIVA_REGISTRADA",
      "PREVENTIVA",
      registro,
      id,
      "SUCESSO",
      "Competência "+competencia+"."
    );

    return {

      ok:true,

      duplicatePrevented:false,

      registro:
        registro,

      competencia:
        competencia

    };

  } finally {

    lock.releaseLock();
  }
}



/* ============================================================
 * HISTÓRICO OC
 * ============================================================ */

function getHistoryByEquipment_(equipmentId) {

  var values =
    prepareHistorySheet_()
      .getDataRange()
      .getValues();

  var target =
    normId_(
      equipmentId
    );

  var result = [];

  for (
    var i = 1;
    i < values.length;
    i++
  ) {

    var r =
      values[i];

    if (
      normId_(r[1]) !==
      target
    ) {

      continue;
    }

    result.push({

      ocorrencia:
        String(r[0] || ""),

      id:
        String(r[1] || ""),

      equipamento:
        String(r[2] || ""),

      data:
        serializeValue_(r[3]) || "",

      reportadoPor:
        String(r[4] || ""),

      contato:
        String(r[5] || ""),

      descricao:
        String(r[6] || ""),

      foto:
        String(r[7] || ""),

      status:
        String(r[8] || ""),

      responsavel:
        String(r[9] || ""),

      dataInicio:
        serializeValue_(r[10]) || "",

      dataConclusao:
        serializeValue_(r[11]) || "",

      solucao:
        String(r[12] || ""),

      fotoConclusao:
        String(r[13] || ""),

      categoriaOcorrencia:
        String(r[14] || ""),

      componenteAfetado:
        String(r[15] || ""),

      ultimaAlteracao:
        serializeValue_(r[16]) || "",

      ultimaAlteracaoPor:
        String(r[17] || ""),

      notificacaoPrestador:
        String(r[18] || ""),

      emailPrestador:
        String(r[19] || "")

    });
  }

  result.sort(
    function(a,b) {

      return (
        new Date(b.data) -
        new Date(a.data)
      );
    }
  );

  return result.slice(
    0,
    CONFIG.HISTORY_LIMIT
  );
}


