/* ============================================================
 * BÁSICO
 * ============================================================ */

function getSpreadsheet_() {

  return SpreadsheetApp.openById(
    CONFIG.SPREADSHEET_ID
  );
}


function normKey_(s) {

  return String(s || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "_")
    .replace(/[^a-z0-9_]/g, "");
}


function normId_(s) {

  return String(s || "")
    .trim()
    .toUpperCase();
}


function normalizarBusca_(texto) {

  return String(texto || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/\s+/g, " ");
}


function sim_(valor) {

  var v =
    normalizarBusca_(valor);

  return (
    v === "sim" ||
    v === "s" ||
    v === "true"
  );
}


function jsonResponse_(obj) {

  return ContentService
    .createTextOutput(
      JSON.stringify(obj)
    )
    .setMimeType(
      ContentService.MimeType.JSON
    );
}


function serializeValue_(value) {

  if (
    value instanceof Date &&
    !isNaN(value)
  ) {

    return Utilities.formatDate(
      value,
      Session.getScriptTimeZone(),
      "yyyy-MM-dd'T'HH:mm:ss"
    );
  }

  return value;
}


function escapeHtml_(texto) {

  return String(texto || "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}


/* ============================================================
 * COMPETÊNCIA
 * ============================================================ */

function getCompetencia_(data) {

  return Utilities.formatDate(
    data || new Date(),
    Session.getScriptTimeZone(),
    "yyyy-MM"
  );
}


function validarCompetencia_(competencia) {

  return /^\d{4}-\d{2}$/
    .test(
      String(competencia || "")
    );
}


function resolverCompetencia_(competencia) {

  var valor =
    String(
      competencia || ""
    ).trim();

  if (!valor) {

    return getCompetencia_(
      new Date()
    );
  }

  if (
    !validarCompetencia_(valor)
  ) {

    throw new Error(
      "Competência inválida. Utilize YYYY-MM."
    );
  }

  return valor;
}


function formatarCompetenciaPtBr_(competencia) {

  var partes =
    String(
      competencia || ""
    ).split("-");

  if (
    partes.length !== 2
  ) {

    return competencia;
  }

  var meses = [
    "",
    "Janeiro",
    "Fevereiro",
    "Março",
    "Abril",
    "Maio",
    "Junho",
    "Julho",
    "Agosto",
    "Setembro",
    "Outubro",
    "Novembro",
    "Dezembro"
  ];

  var mes =
    Number(
      partes[1]
    );

  if (
    mes < 1 ||
    mes > 12
  ) {

    return competencia;
  }

  return (
    meses[mes] +
    "/" +
    partes[0]
  );
}


