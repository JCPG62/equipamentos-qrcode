}


function configurarQRManut743() {

  /*
   * QRManut 7.4.3
   * Configuração principal da versão.
   *
   * Esta função é idempotente:
   * pode ser executada novamente sem apagar os dados existentes.
   */

  prepareHistorySheet_();

  preparePreventiveSheet_();

  preparePreventiveAccessSheet_();

  prepareSystemAccessSheet_();

  preparePreventiveReportLogSheet_();

  prepareTechnicalDocumentsSheet_();

  prepareTechnicalDocumentLinksSheet_();

  configurarDropdownsDependentesLocalizacao();

  configurarDocumentosTecnicos73();

  configurarVinculosDocumentos731();

  /*
   * Segurança / Usuários / Prestadores / Auditoria.
   */
  configurarSeguranca740_();

  /*
   * Configuração institucional da empresa.
   */
  prepareCompanyConfigSheet_();

  /*
   * Performance 7.4.3.
   */
  preparePerformanceSheet_();

  /*
   * Limpa caches para que a nova versão comece
   * lendo os dados atuais da planilha.
   */
  invalidateStaticCaches_();

  SpreadsheetApp.flush();

  Logger.log(
    "================================="
  );

  Logger.log(
    "QRManut 7.4.3 configurado."
  );

  Logger.log(
    CONFIG.VERSION
  );

  Logger.log(
    "Configuração concluída com sucesso."
  );

  Logger.log(
    "================================="
  );
}

