/* ============================================================
 * ACESSOS PREVENTIVA
 *
 * A Prestador
 * B Usuário
 * C Senha
 * D Perfil
 * E Ativo
 * F Exigir Assinatura
 * G Foto Obrigatória
 * H Observação Obrigatória
 * I Notificar OC
 * J E-mail OC
 * K Enviar Relatório Preventivas
 * L E-mail Relatório
 * ============================================================ */

function getPreventiveAccessSheet_() {

  var ss =
    getSpreadsheet_();

  var sh =
    ss.getSheetByName(
      CONFIG.PREVENTIVE_ACCESS_SHEET
    );

  if (!sh) {

    sh =
      ss.insertSheet(
        CONFIG.PREVENTIVE_ACCESS_SHEET
      );
  }

  return sh;
}


function preparePreventiveAccessSheet_() {

  var sh =
    getPreventiveAccessSheet_();

  var headers = [

    "Prestador",
    "Usuário",
    "Senha",
    "Perfil",
    "Ativo",
    "Exigir Assinatura",
    "Foto Obrigatória",
    "Observação Obrigatória",
    "Notificar OC",
    "E-mail OC",
    "Enviar Relatório Preventivas",
    "E-mail Relatório"

  ];

  sh.getRange(
    1,
    1,
    1,
    headers.length
  )
  .setValues([
    headers
  ])
  .setFontWeight(
    "bold"
  );

  sh.setFrozenRows(1);

  return sh;
}


function readPreventiveAccess_() {

  var values =
    preparePreventiveAccessSheet_()
      .getDataRange()
      .getDisplayValues();

  var result = [];

  for (
    var i = 1;
    i < values.length;
    i++
  ) {

    var r =
      values[i];

    if (
      !String(r[0] || "").trim() &&
      !String(r[1] || "").trim()
    ) {

      continue;
    }

    result.push({

      prestador:
        String(r[0] || "").trim(),

      usuario:
        String(r[1] || "").trim(),

      senha:
        String(r[2] || ""),

      perfil:
        String(
          r[3] ||
          "PRESTADOR"
        )
        .trim()
        .toUpperCase(),

      ativo:
        normalizarBusca_(
          r[4]
        ) !== "nao",

      exigirAssinatura:
        sim_(r[5]),

      fotoObrigatoria:
        sim_(r[6]),

      observacaoObrigatoria:
        sim_(r[7]),

      notificarOC:
        sim_(r[8]),

      emailOC:
        String(r[9] || "")
          .trim(),

      enviarRelatorio:
        sim_(r[10]),

      emailRelatorio:
        String(r[11] || "")
          .trim()

    });
  }

  return result;
}


/* ============================================================
 * REGRAS
 * ============================================================ */

function getProviderRows_(prestador) {

  var target =
    normalizarBusca_(
      prestador
    );

  return readPreventiveAccess_()
    .filter(
      function(x) {

        return (
          x.ativo &&
          normalizarBusca_(
            x.prestador
          ) === target
        );
      }
    );
}


function getProviderRules_(prestador) {
  var p=getProviderByName_(prestador);
  return {exigirAssinatura:p?p.exigirAssinatura:false,fotoObrigatoria:p?p.fotoObrigatoria:false,observacaoObrigatoria:p?p.observacaoObrigatoria:false};
}


function coletarEmails_(texto) {

  var emails = [];

  String(
    texto || ""
  )
  .split(/[;,]/)
  .forEach(
    function(item) {

      var email =
        String(item || "")
          .trim();

      if (
        email &&
        emails.indexOf(email) === -1
      ) {

        emails.push(email);
      }
    }
  );

  return emails;
}


function getProviderNotificationConfig_(prestador) {
  var p=getProviderByName_(prestador),emails=p?coletarEmails_(p.emailOC):[];
  return {notificar:p?p.notificarOC:false,emails:emails,emailString:emails.join(",")};
}


function getProviderReportConfig_(prestador) {
  var p=getProviderByName_(prestador),emails=p?coletarEmails_(p.emailRelatorio):[];
  return {permitido:p?p.enviarRelatorio:false,emails:emails,emailString:emails.join(",")};
}


