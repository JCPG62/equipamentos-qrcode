/* ============================================================
 * TESTE 7.3.3 - PROTEÇÃO DUPLICIDADE PREVENTIVA
 * ============================================================ */

function testeProtecaoDuplicidadePreventiva733() {

  var idTeste =
    "AC102_SP3P";

  var competenciaTeste =
    getCompetencia_(
      new Date()
    );

  var responsavelTeste =
    "Gabriel";

  var encontrado =
    findRecentPreventiveDuplicate_(
      idTeste,
      competenciaTeste,
      responsavelTeste,
      new Date()
    );

  Logger.log(
    "Janela de proteção: " +
    CONFIG.PREVENTIVE_DUPLICATE_WINDOW_MINUTES +
    " minutos"
  );

  Logger.log(
    JSON.stringify(
      encontrado,
      null,
      2
    )
  );
}

