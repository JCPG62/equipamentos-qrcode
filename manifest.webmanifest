/* ============================================================
 * PERFORMANCE / CACHE – 7.4.3
 * ============================================================ */

function staticCache_(){
  return CacheService.getScriptCache();
}

function cacheGetJson_(key){
  try{
    var raw=staticCache_().get(key);
    return raw?JSON.parse(raw):null;
  }catch(e){
    return null;
  }
}

function cachePutJson_(key,value,seconds){
  try{
    staticCache_().put(
      key,
      JSON.stringify(value),
      seconds||CONFIG.STATIC_CACHE_SECONDS
    );
  }catch(e){
    Logger.log("Cache put ignorado: "+e);
  }
}

function invalidateStaticCaches_(){
  try{
    staticCache_().removeAll([
      "v743_equipamentos",
      "v743_prestadores",
      "v743_empresa",
      "v743_documentos",
      "v743_documentos_vinculos"
    ]);
  }catch(e){}
}

function invalidateEquipmentCache_(){
  try{staticCache_().remove("v743_equipamentos");}catch(e){}
}

function invalidateProviderCache_(){
  try{staticCache_().remove("v743_prestadores");}catch(e){}
}

function invalidateCompanyCache_(){
  try{staticCache_().remove("v743_empresa");}catch(e){}
}

function invalidateDocumentCaches_(){
  try{
    staticCache_().removeAll([
      "v743_documentos",
      "v743_documentos_vinculos"
    ]);
  }catch(e){}
}

function preparePerformanceSheet_(){
  var ss=getSpreadsheet_();
  var sh=ss.getSheetByName(CONFIG.PERFORMANCE_SHEET);
  if(!sh)sh=ss.insertSheet(CONFIG.PERFORMANCE_SHEET);
  var h=["Data/Hora","Rota","Duração (ms)","ID Usuário","Perfil","Detalhes"];
  sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold");
  sh.setFrozenRows(1);
  return sh;
}

function recordPerformance_(route,started,sessao,detalhes){
  try{
    var ms=Date.now()-started;
    if(ms<CONFIG.PERFORMANCE_LOG_THRESHOLD_MS)return ms;
    preparePerformanceSheet_().appendRow([
      new Date(),
      route||"",
      ms,
      sessao&&sessao.idUsuario?sessao.idUsuario:"",
      sessao&&sessao.perfil?sessao.perfil:"",
      detalhes||""
    ]);
    return ms;
  }catch(e){
    return Date.now()-started;
  }
}

function buildAssetBundle_(id){
  var t=Date.now();
  var rows=readEquipmentSheet_();
  var ativo=findEquipmentById_(rows,id);
  if(!ativo){
    recordPerformance_("assetbundle",t,null,"not_found");
    return {ok:false,error:"not_found"};
  }

  var payload=buildEquipmentPayload_(ativo);
  var status=getEquipmentStatusSummary_(id);
  var history=getHistoryByEquipment_(id);
  var docs=getTechnicalDocumentsByAsset_(id);

  var ms=recordPerformance_(
    "assetbundle",
    t,
    null,
    "id="+id+"; history="+(history||[]).length+"; docs="+(docs||[]).length
  );

  return {
    ok:true,
    data:payload,
    status:status,
    history:history||[],
    documents:docs||[],
    performanceMs:ms
  };
}


function readEquipmentSheet_() {

  var cached=cacheGetJson_("v743_equipamentos");
  if(cached)return cached;

  var sh =
    getSpreadsheet_()
      .getSheetByName(
        CONFIG.EQUIPMENT_SHEET
      );

  if (!sh) {
    throw new Error(
      "Aba Equipamentos não encontrada."
    );
  }

  var lastRow=sh.getLastRow();
  var lastCol=sh.getLastColumn();

  if(lastRow<=1 || lastCol<=0){
    cachePutJson_("v743_equipamentos",[]);
    return [];
  }

  var values =
    sh.getRange(
      1,
      1,
      lastRow,
      lastCol
    ).getValues();

  var headers =
    values[0].map(
      normKey_
    );

  var result=values
    .slice(1)
    .filter(function(row){
      return row.some(function(v){
        return String(v).trim() !== "";
      });
    })
    .map(function(row){
      var obj = {};
      headers.forEach(function(h,i){
        obj[h] = serializeValue_(row[i]);
      });
      return obj;
    });

  cachePutJson_(
    "v743_equipamentos",
    result
  );

  return result;
}


function findEquipmentById_(rows,id) {

  var target =
    normId_(id);

  for (
    var i = 0;
    i < rows.length;
    i++
  ) {

    if (
      normId_(rows[i].id) ===
      target
    ) {

      return rows[i];
    }
  }

  return null;
}


function buildEquipmentPayload_(eq) {

  return {

    id:
      eq.id || "",

    nome_do_equipamento:
      eq.nome_do_equipamento || "",

    fabricante:
      eq.fabricante || "",

    modelo:
      eq.modelo || "",

    numero_de_serie:
      eq.numero_de_serie || "",

    capacidade:
      eq.capacidade || "",

    amperagem_nominal_fla:
      eq.amperagem_nominal_fla || "",

    amperagem_de_partida_flr:
      eq.amperagem_de_partida_flr || "",

    amperagem_medida:
      eq.amperagem_medida || "",

    voltagem:
      eq.voltagem || "",

    peso:
      eq.peso || "",

    ano_de_aquisicao:
      eq.ano_de_aquisicao || "",

    vida_util_estimada:
      eq.vida_util_estimada || "",

    status:
      eq.status || "",

    observacoes:
      eq.observacoes || "",

    prestador:
      eq.prestador || "",

    periodicidade:
      eq.periodicidade || "",

    tipo_de_ativo:
      eq.tipo_de_ativo ||
      "Equipamento",

    categoria_do_ativo:
      eq.categoria_do_ativo || "",

    subcategoria:
      eq.subcategoria || "",

    area:
      eq.area || "",

    ambiente:
      eq.ambiente || "",

    componente_elemento:
      eq.componente__elemento ||
      eq.componente_elemento ||
      "",

    pavimento:
      eq.pavimento || "",

    localizacao:
      eq.localizacao || "",

    criticidade:
      eq.criticidade || "",

    classe_de_manutencao:
      eq.classe_de_manutencao || "",

    local_detalhado:
      eq.local_detalhado || ""

  };
}


/* ============================================================
 * BUSCA GERAL
 * ============================================================ */

function buscarAtivos_(termo) {

  var busca =
    normalizarBusca_(
      termo
    );

  if (
    !busca ||
    busca.length < 2
  ) {

    return [];
  }

  var ativos =
    readEquipmentSheet_();

  var resultados = [];

  for (
    var i = 0;
    i < ativos.length;
    i++
  ) {

    var a =
      ativos[i];

    var texto = [

      a.id,
      a.nome_do_equipamento,
      a.fabricante,
      a.modelo,
      a.numero_de_serie,
      a.localizacao,
      a.tipo_de_ativo,
      a.categoria_do_ativo,
      a.subcategoria,
      a.area,
      a.ambiente,
      a.componente__elemento,
      a.pavimento,
      a.criticidade,
      a.classe_de_manutencao,
      a.local_detalhado,
      a.prestador,
      a.periodicidade,
      a.status

    ]
    .map(
      normalizarBusca_
    )
    .join(" ");

    if (
      texto.indexOf(busca) === -1
    ) {

      continue;
    }

    resultados.push({

      id:
        a.id || "",

      nome:
        a.nome_do_equipamento || "",

      tipo:
        a.tipo_de_ativo ||
        "Equipamento",

      pavimento:
        a.pavimento || "",

      localizacao:
        a.localizacao || "",

      ambiente:
        a.ambiente || "",

      localDetalhado:
        a.local_detalhado || "",

      fabricante:
        a.fabricante || "",

      modelo:
        a.modelo || "",

      status:
        a.status || "",

      prestador:
        a.prestador || "",

      periodicidade:
        a.periodicidade || ""

    });

    if (
      resultados.length >=
      CONFIG.SEARCH_LIMIT
    ) {

      break;
    }
  }

  return resultados;
}


